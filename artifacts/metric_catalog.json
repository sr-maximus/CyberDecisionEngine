{
  "active_targets": {
    "label": "Objetivos en alcance",
    "definition": "Sujeto principal declarado y dominios primarios persistidos en la corrida.",
    "formula": "count(distinct declared_subject + primary_domains)",
    "unit": "targets",
    "numerator": "count(distinct declared_subject + primary_domains)",
    "denominator": "not_applicable",
    "range": "0..n",
    "source": "DecisionIntelligenceSnapshot",
    "update": "once per completed analysis run",
    "missing_data_status": "no_data",
    "dashboards": [
      "strategic_dashboard"
    ],
    "reports": [
      "executive",
      "technical",
      "json",
      "csv"
    ]
  },
  "active_domains": {
    "label": "Dominios en alcance",
