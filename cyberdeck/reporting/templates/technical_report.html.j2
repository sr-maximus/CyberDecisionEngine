        <span>{{ "Cyber-PESTEL" if loop.index <= (metrics.pestel.dimensions | length) else "Cyber-Porter" }}</span>
        <strong>{{ strategic_labels_en.get(item.key, item.shortName | default(item.name, true)) if report_lang == "en" else item.shortName | default(item.name, true) }}</strong>
