      </article>
      {% endfor %}
    </div>
    <div class="method-grid">
      <article><h3>{{ "Risk model" if report_lang == "en" else "Modelo de riesgo" }}</h3><p>{{ metrics.risk_methodology.purpose }}</p></article>
      <article><h3>{{ "Contextual plausibility" if report_lang == "en" else "Plausibilidad contextual" }}</h3><p>{{ metrics.risk_methodology.likelihood }}</p></article>
      <article><h3>Impact</h3><p>{{ metrics.risk_methodology.impact }}</p></article>
      <article><h3>Control Effectiveness</h3><p>{{ metrics.risk_methodology.control_effectiveness }}</p></article>
      <article><h3>Matrix</h3><p>{{ metrics.risk_methodology.matrix }}</p></article>
      <article><h3>Monte Carlo / Forecast</h3><p>{{ metrics.risk_methodology.monte_carlo }}</p></article>
    </div>
    <h3>{{ "Applied model summary" if report_lang == "en" else "Resumen de modelos aplicados" }}</h3>
    <div class="formula-grid model-brief-grid">
      {% for model in model_summary.brief_models %}
      <article class="formula-card model-brief-card">
        <span>{{ model.title }}</span>
        <p>{{ model.summary }}</p>
      </article>
      {% endfor %}
    </div>
    <h3>{{ "Signal-pressure sensitivity bands" if report_lang == "en" else "Bandas de sensibilidad de presión de señales" }}</h3>
    <div class="callout compact">
      <strong>{{ "Prospective model" if report_lang == "en" else "Modelo prospectivo" }}:</strong>
      {{ prospective.status }} ·
      {{ "attack probability not published because the model is not calibrated" if report_lang == "en" else "no se publica probabilidad de ataque porque el modelo no está calibrado" }}.
      {% if prospective.trend.change_ratio is not none %}<br><span class="small">{{ "Validated-evidence trend" if report_lang == "en" else "Tendencia de evidencia validada" }}: {{ prospective.trend.direction }} ({{ "%+.1f"|format(prospective.trend.change_ratio * 100) }}%).</span>{% endif %}
    </div>
    <table>
      <tr><th>{{ "Horizon" if report_lang == "en" else "Horizonte" }}</th><th>{{ "Lower" if report_lang == "en" else "Inferior" }}</th><th>{{ "Base" if report_lang == "en" else "Base" }}</th><th>{{ "Upper" if report_lang == "en" else "Superior" }}</th><th>{{ "Interpretation" if report_lang == "en" else "Interpretación" }}</th></tr>
      {% for days, forecast in metrics.forecast.items() %}
      {% set lower = forecast.get('lower_sensitivity') if forecast.get('lower_sensitivity') is not none else forecast.get('p10') %}
      {% set base = forecast.get('base_sensitivity') if forecast.get('base_sensitivity') is not none else forecast.get('p50') %}
      {% set upper = forecast.get('upper_sensitivity') if forecast.get('upper_sensitivity') is not none else forecast.get('p90') %}
      <tr>
        <td>{{ days }} {{ "days" if report_lang == "en" else "días" }}</td>
        <td>{% if lower is not none %}{{ "%.1f"|format(lower * 100) }}/100{% else %}N/D{% endif %}</td>
        <td>{% if base is not none %}{{ "%.1f"|format(base * 100) }}/100{% else %}N/D{% endif %}</td>
        <td>{% if upper is not none %}{{ "%.1f"|format(upper * 100) }}/100{% else %}N/D{% endif %}</td>
        <td>{{ forecast.language }}</td>
      </tr>
      {% endfor %}
    </table>
    </div>
  </details>

  <details id="inteligencia-publica" class="report-module">
    <summary><span>07B</span><h2>{{ "OSINT and SOCMINT results by evidence type" if report_lang == "en" else "Resultados OSINT y SOCMINT por tipología" }}</h2><small>{{ processing_summary.unique_records | default(raw_events|length) }} {{ "records" if report_lang == "en" else "registros" }}</small></summary>
    <div class="report-module-body">
    <p class="small">{{ "Only collected records related to the current scope are presented. Connector operation remains in the administrative console and is not part of the intelligence report." if report_lang == "en" else "Se presentan únicamente registros recolectados relacionados con el alcance actual. La operación de conectores permanece en la consola administrativa y no forma parte del informe de inteligencia." }}</p>
    <h3>{{ "Collected public-intelligence groups" if report_lang == "en" else "Grupos de inteligencia pública recolectada" }}</h3>
    <div class="search-results">
      {% for key, group in search_groups.items() if key != "total" %}
      <details class="search-panel" {% if group.rows %}open{% endif %}>
        <summary><span>{{ group.title_en if report_lang == "en" else group.title }}</span><strong>{{ group.count }}</strong></summary>
        {% if group.rows %}
        <div class="evidence-table search-table search-result-table">
          <table>
            <tr><th>{{ "Source" if report_lang == "en" else "Fuente" }}</th><th>{{ "Type" if report_lang == "en" else "Tipo" }}</th><th>{{ "Result" if report_lang == "en" else "Resultado" }}</th><th>{{ "Observed" if report_lang == "en" else "Observado" }}</th><th>{{ "Classification" if report_lang == "en" else "Clasificación" }}</th><th>{{ "Relationship" if report_lang == "en" else "Relación" }}</th><th>URL</th></tr>
            {% for row in group.rows %}
            <tr>
              <td>{{ row.source }}</td>
              <td><strong>{{ row.evidence_type_label }}</strong><br><span class="small">{{ row.category_label }}</span></td>
              <td>{{ row.title }}</td>
              <td class="observation-cell"><strong>{{ row.observed_date }}</strong><span>{{ row.recency_label }}</span></td>
              <td>{{ row.tags or ("Unclassified" if report_lang == "en" else "Sin etiquetas relevantes") }}</td>
              <td>{{ row.relationship }}<br><span class="small">{{ row.validation }}</span></td>
              <td>{% if row.evidence_url %}<a class="full-url" href="{{ row.evidence_url }}">{{ row.evidence_url }}</a>{% else %}<span class="small">{{ "No direct URL" if report_lang == "en" else "Sin URL directa" }}</span>{% endif %}</td>
            </tr>
            {% endfor %}
          </table>
        </div>
        {% else %}
        <p class="small">{{ "No records in this run." if report_lang == "en" else "Sin registros en esta corrida." }}</p>
        {% endif %}
      </details>
      {% endfor %}
    </div>
    </div>
  </details>

  <details id="vulnerabilidades" class="report-module">
    <summary><span>02D</span><h2>{{ "Vulnerability Intelligence and Patch Focus" if report_lang == "en" else "Inteligencia de vulnerabilidades y foco de parches" }}</h2><small>{{ vuln_intel.confirmed_cves }} CVE · {{ vuln_intel.kev_matches }} KEV</small></summary>
    <div class="report-module-body">
    <p class="small">{{ vuln_intel.method }}</p>
    <div class="brand-report-grid">
      {% if vuln_intel.confirmed_cves %}
      <article class="brand-score-card"><span>{{ "Applicable CVEs" if report_lang == "en" else "CVE aplicables" }}</span><strong>{{ vuln_intel.confirmed_cves }}</strong></article>
      {% endif %}
      {% if vuln_intel.technology_matches_pending_version | default(0, true) %}
      <article class="brand-score-card"><span>{{ "Product matches pending version" if report_lang == "en" else "Producto coincidente pendiente de versión" }}</span><strong>{{ vuln_intel.technology_matches_pending_version | default(0, true) }}</strong></article>
      {% endif %}
      {% if vuln_intel.contextual_cves | default(0, true) %}
      <article class="brand-score-card"><span>{{ "Context-only CVEs" if report_lang == "en" else "CVE solo contextuales" }}</span><strong>{{ vuln_intel.contextual_cves | default(0, true) }}</strong></article>
      {% endif %}
      {% if vuln_intel.kev_matches %}
      <article class="brand-score-card"><span>KEV</span><strong>{{ vuln_intel.kev_matches }}</strong></article>
      {% endif %}
      {% if vuln_intel.public_exploit_references | default(0, true) %}
      <article class="brand-score-card"><span>{{ "Public exploit references" if report_lang == "en" else "Referencias públicas de exploit" }}</span><strong>{{ vuln_intel.public_exploit_references | default(0, true) }}</strong></article>
      {% endif %}
      {% if vuln_intel.cvss_v4_records | default(0, true) %}
      <article class="brand-score-card"><span>CVSS v4</span><strong>{{ vuln_intel.cvss_v4_records | default(0, true) }}</strong></article>
      {% endif %}
      {% if vuln_intel.observed_technologies %}
      <article class="brand-score-card"><span>{{ "Observed technologies" if report_lang == "en" else "Tecnologías observadas" }}</span><strong>{{ vuln_intel.observed_technologies }}</strong></article>
      {% endif %}
      {% if vuln_intel.surface_assets %}
      <article class="brand-score-card"><span>{{ "Surface assets" if report_lang == "en" else "Activos de superficie" }}</span><strong>{{ vuln_intel.surface_assets }}</strong></article>
      {% endif %}
    </div>
    <div class="callout compact"><strong>{{ "Patch focus" if report_lang == "en" else "Foco de parches" }}:</strong> {{ vuln_intel.patch_focus }}</div>
    {% if vuln_intel.rows %}
    <div class="vulnerability-card-grid">
      {% for row in vuln_intel.rows %}
      <article class="vulnerability-card {{ row.type }}">
        <div class="vulnerability-card-head">
          <div>
            <span>{{ row.type_label }}</span>
            <h3>{{ row.label }}</h3>
          </div>
          {% if row.cvss_score is not none %}<strong>CVSS {{ "%.1f"|format(row.cvss_score) }}</strong>{% endif %}
        </div>
        <div class="vulnerability-meta">
          <div><small>{{ "Asset" if report_lang == "en" else "Activo" }}</small><b>{{ row.asset }}</b></div>
          <div><small>{{ "Product / version" if report_lang == "en" else "Producto / versión" }}</small><b>{{ row.product or row.label }}{% if row.observed_version %} {{ row.observed_version }}{% else %} · {{ "version not determined" if report_lang == "en" else "versión no determinada" }}{% endif %}</b></div>
        </div>
        <div class="vulnerability-reading">
          <p><b>{{ "Observation" if report_lang == "en" else "Observación" }}:</b> {{ row.status }}</p>
          <p><b>{{ "What it demonstrates" if report_lang == "en" else "Qué demuestra" }}:</b> {{ row.what_it_demonstrates }}</p>
          <p><b>{{ "What it does not demonstrate" if report_lang == "en" else "Qué no demuestra" }}:</b> {{ row.what_it_does_not_demonstrate }}</p>
          <p><b>{{ "Next validation" if report_lang == "en" else "Siguiente validación" }}:</b> {{ row.decision }}</p>
        </div>
        {% if row.evidence_url %}<a class="vulnerability-evidence-link" href="{{ row.evidence_url }}" target="_blank" rel="noreferrer">{{ "View supporting record" if report_lang == "en" else "Ver registro de soporte" }}</a>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">{{ "No applicable vulnerability or product-matched candidate was established in this run." if report_lang == "en" else "No se estableció vulnerabilidad aplicable ni candidata con coincidencia de producto en esta corrida." }}</div>
    {% endif %}
    </div>
  </details>

  {% if layered_risk.status == "calculated" %}
  <details id="riesgo-cuantitativo" class="report-module">
    <summary><span>02E</span><h2>{{ "Layered organizational scenario analysis" if report_lang == "en" else "Análisis de escenarios organizacionales por capas" }}</h2><small>{{ layered_risk.scenarios | length }} {{ "scenarios" if report_lang == "en" else "escenarios" }}</small></summary>
    <div class="report-module-body">
    <p class="small">{{ "This optional model uses only scenario frequency, consequence and protection layers declared for the run. It does not infer values from public intelligence and does not predict an attack." if report_lang == "en" else "Este modelo opcional usa únicamente frecuencia, consecuencia y capas de protección declaradas para la corrida. No infiere valores desde inteligencia pública ni predice un ataque." }}</p>
    <div class="brand-report-grid">
      <article class="brand-score-card"><span>{{ "Layered scenarios" if report_lang == "en" else "Escenarios por capas" }}</span><strong>{{ ("Calculated" if report_lang == "en" else "Calculado") if layered_risk.status == "calculated" else "N/D" }}</strong><small>{{ layered_risk.scenarios | length }} {{ "supported inputs" if report_lang == "en" else "entradas respaldadas" }}</small></article>
    </div>
    <div class="evidence-table search-table">
      <table>
        <tr><th>{{ "Scenario" if report_lang == "en" else "Escenario" }}</th><th>{{ "Initial frequency/year" if report_lang == "en" else "Frecuencia inicial/año" }}</th><th>{{ "Combined layer failure" if report_lang == "en" else "Fallo combinado de capas" }}</th><th>{{ "Resulting frequency/year" if report_lang == "en" else "Frecuencia resultante/año" }}</th><th>{{ "Consequence" if report_lang == "en" else "Consecuencia" }}</th><th>{{ "Expected annual loss" if report_lang == "en" else "Pérdida anual esperada" }}</th><th>{{ "Layers" if report_lang == "en" else "Capas" }}</th></tr>
        {% for row in layered_risk.scenarios %}
        <tr><td>{{ row.scenario_name }}</td><td>{{ "%.6f"|format(row.initiating_event_frequency) }}</td><td>{{ "%.2f"|format(row.combined_layer_failure_probability * 100) }}%</td><td>{{ "%.6f"|format(row.resulting_event_frequency) }}</td><td>{{ row.currency }} {{ "%.2f"|format(row.consequence_value) }}</td><td>{{ row.currency }} {{ "%.2f"|format(row.expected_annual_loss) }}</td><td>{{ row.protection_layers | length }}</td></tr>
        {% endfor %}
      </table>
    </div>
    </div>
  </details>
  {% endif %}

  <details id="threat-matrix" class="report-module">
    <summary><span>03</span><h2>{{ "Threat matrix" if report_lang == "en" else "Matriz de amenazas" }}</h2><small>{{ cti_overview.actor_count | default(0, true) }} {{ "entities" if report_lang == "en" else "entidades" }} · {{ cti_overview.technique_count | default(0, true) }} TTP</small></summary>
    <div class="report-module-body threat-matrix-module">
  <section id="mitre" class="report-subsection">
    <h3>MITRE ATT&CK</h3>
    <p class="small">{{ metrics.mitre.purpose }}</p>
    <div class="ttp-matrix">
      {% for tactic in metrics.mitre.tactics %}
      <details class="ttp-row">
        <summary><span>{{ tactic.name }}</span><strong>{{ tactic.count }}</strong></summary>
        {% if tactic.techniques %}
        <table>
          <tr><th>{{ "Technique" if report_lang == "en" else "Técnica" }}</th><th>{{ "Collected records" if report_lang == "en" else "Registros recolectados" }}</th><th>{{ "Sources" if report_lang == "en" else "Fuentes" }}</th><th>D3FEND</th><th>{{ "Examples" if report_lang == "en" else "Ejemplos" }}</th></tr>
          {% for technique in tactic.techniques %}
          <tr>
            <td><strong>{{ technique.id }}</strong><br>{{ technique.name }}</td>
            <td>{{ technique.count }}</td>
            <td>{{ technique.sources | join(", ") }}</td>
            <td>{% for d3 in technique.d3fend %}<span class="badge">{{ d3.id }} {{ d3.name }}</span> {% endfor %}</td>
            <td><ul>{% for example in technique.examples %}<li>{% if example.url %}<a href="{{ example.url }}">{{ example.title }}</a>{% else %}{{ example.title }}{% endif %}</li>{% endfor %}</ul></td>
          </tr>
          {% endfor %}
        </table>
        {% else %}
        <p class="small">{{ "No validated records were mapped to this tactic in the current run." if report_lang == "en" else "Sin registros validados mapeados a esta táctica en la corrida actual." }}</p>
        {% endif %}
      </details>
      {% endfor %}
    </div>
  </section>

  <section id="d3fend" class="report-subsection">
    <h3>MITRE D3FEND</h3>
    <p class="small">{{ metrics.d3fend.purpose }}</p>
    <table>
      <tr><th>ID</th><th>{{ "Countermeasure" if report_lang == "en" else "Contramedida" }}</th><th>{{ "Collected records" if report_lang == "en" else "Registros recolectados" }}</th><th>{{ "Action" if report_lang == "en" else "Acción" }}</th><th>{{ "Tools" if report_lang == "en" else "Herramientas" }}</th><th>{{ "Examples" if report_lang == "en" else "Ejemplos" }}</th></tr>
      {% for row in metrics.d3fend.rows %}
      <tr><td>{{ row.id }}</td><td>{{ row.name }}</td><td>{{ row.count }}</td><td>{{ row.action }}</td><td>{{ row.tools }}</td><td>{{ row.samples | join("; ") }}</td></tr>
      {% endfor %}
    </table>
  </section>

  <section id="atlas" class="report-subsection">
    <h3>MITRE ATLAS</h3>
    <p class="small">{{ "Activated strictly when there are explicit AI/model/agent/prompt or AI supply-chain signals. If no explicit signal exists, the section remains preventive." if report_lang == "en" else "Se activa de forma estricta cuando hay señales explícitas de IA/modelos/agentes/prompts o cadena de suministro de IA. Si no hay señal explícita, la sección queda como preventiva." }}</p>
    <table>
      <tr><th>{{ "Section" if report_lang == "en" else "Sección" }}</th><th>{{ "Risk" if report_lang == "en" else "Riesgo" }}</th><th>{{ "Control" if report_lang == "en" else "Control" }}</th></tr>
      {% for item in metrics.atlas.sections %}
      <tr><td>{{ item.id }} {{ item.name }}</td><td>{{ item.risk }}</td><td>{{ item.controls }}</td></tr>
      {% endfor %}
    </table>
  </section>

  <section id="threat-actors-ttps" class="report-subsection">
    {% set cti = metrics.cti | default({}, true) %}
    {% set cti_overview = cti.overview | default({}, true) %}
    <h3>{{ "Threat actors, groups, campaigns, software and TTP traceability" if report_lang == "en" else "Trazabilidad de actores, grupos, campañas, software y TTP" }}</h3>
    <p class="small">{{ "Every entity is classified as OBSERVED, INFERRED, RELATED or REFERENCE. OBSERVED requires confirmed adversary telemetry; contextual relevance never confirms an incident." if report_lang == "en" else "Cada entidad se clasifica como OBSERVADA, INFERIDA, RELACIONADA o REFERENCIA. OBSERVADA exige telemetría adversaria confirmada; la relevancia contextual nunca confirma un incidente." }}</p>
    <div class="kpi-grid cti-kpi-grid" data-cti-actor-count="{{ cti_overview.actor_count | default(0, true) }}" data-cti-campaign-count="{{ cti_overview.campaign_count | default(0, true) }}" data-cti-technique-count="{{ cti_overview.technique_count | default(0, true) }}">
      <div class="kpi cti-kpi"><b>{{ cti_overview.actor_count | default(0, true) }}</b><span>{{ "Actors" if report_lang == "en" else "Actores" }}</span></div>
      <div class="kpi cti-kpi"><b>{{ cti_overview.campaign_count | default(0, true) }}</b><span>{{ "Campaigns" if report_lang == "en" else "Campañas" }}</span></div>
      <div class="kpi cti-kpi"><b>{{ cti_overview.technique_count | default(0, true) }}</b><span>TTP</span></div>
      <div class="kpi cti-kpi"><b>{{ cti_overview.evidence_count | default(0, true) }}</b><span>{{ "Evidence references" if report_lang == "en" else "Referencias de evidencia" }}</span></div>
    </div>
    {% if cti.actors %}
    <div class="threat-report-list">
      {% for actor in cti.actors %}
      <details class="threat-report-row">
        <summary>
          <span>{{ actor.state if report_lang == "en" else cti_states_es.get(actor.state, actor.state) }}</span>
          <strong>{{ actor.name }}</strong>
          <em>{{ actor.relevance_score }}/100 · {{ actor.evidence_count }} {{ "records" if report_lang == "en" else "registros" }}</em>
          <b>{{ actor.relevance_band if report_lang == "en" else cti_bands_es.get(actor.relevance_band, actor.relevance_band) }}</b>
        </summary>
        <div class="threat-report-detail">
          <div class="wide"><strong>{{ "Analytical interpretation" if report_lang == "en" else "Interpretación analítica" }}</strong><span>{{ actor.explanation }}</span></div>
          <div><strong>{{ "Relationship" if report_lang == "en" else "Relación" }}</strong><span>{{ actor.relationships | join(" · ") if actor.relationships else "N/D" }}</span></div>
          <div><strong>{{ "Campaigns" if report_lang == "en" else "Campañas" }}</strong><span>{{ actor.campaigns | join(" · ") if actor.campaigns else "N/D" }}</span></div>
          <div class="wide"><strong>ATT&amp;CK TTP</strong>
            <div class="framework-chip-row">
              {% for technique in actor.techniques %}<span><b>{{ technique }}</b></span>{% else %}<span>N/D</span>{% endfor %}
            </div>
          </div>
          <div class="wide"><strong>D3FEND</strong>
            <div class="framework-chip-row defensive">
              {% for control in actor.d3fend %}<span><b>{{ control.id }}</b>{% if control.name %} · {{ control.name }}{% endif %}</span>{% else %}<span>{{ "No mapped countermeasure for the related TTP" if report_lang == "en" else "Sin contramedida mapeada para la TTP relacionada" }}</span>{% endfor %}
            </div>
          </div>
          <div><strong>{{ "Related frameworks" if report_lang == "en" else "Marcos relacionados" }}</strong><span>{{ actor.frameworks | join(" · ") if actor.frameworks else "N/D" }}</span></div>
          <div><strong>{{ "Last observation" if report_lang == "en" else "Última observación" }}</strong><span>{{ actor.last_observed_at or "N/D" }}</span></div>
          <div class="wide"><strong>{{ "Limitations" if report_lang == "en" else "Limitaciones" }}</strong><span>{{ actor.limitations | join(" · ") if actor.limitations else ("No additional limitations" if report_lang == "en" else "Sin limitaciones adicionales") }}</span></div>
          <div class="wide framework-chip-row">{% for url in actor.evidence_urls %}<a class="compact-source-link" href="{{ url }}" title="{{ url }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }} {{ loop.index }}</a>{% endfor %}</div>
        </div>
      </details>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">{{ "No actor attribution with traceable current-run evidence was identified." if report_lang == "en" else "No se identificó atribución de actor con evidencia trazable de la corrida actual." }}</div>
    {% endif %}

    {% if cti.campaigns %}
    <h3>{{ "Campaigns" if report_lang == "en" else "Campañas" }}</h3>
    <div class="evidence-table"><table>
      <tr><th>{{ "Campaign" if report_lang == "en" else "Campaña" }}</th><th>{{ "State" if report_lang == "en" else "Estado" }}</th><th>{{ "Actors" if report_lang == "en" else "Actores" }}</th><th>TTP</th><th>{{ "Evidence" if report_lang == "en" else "Evidencia" }}</th></tr>
      {% for campaign in cti.campaigns %}<tr class="cti-campaign-row"><td><strong>{{ campaign.name }}</strong></td><td>{{ campaign.state if report_lang == "en" else cti_states_es.get(campaign.state, campaign.state) }}</td><td>{{ campaign.actors | join(" · ") if campaign.actors else "N/D" }}</td><td>{{ campaign.techniques | join(" · ") if campaign.techniques else "N/D" }}</td><td>{{ campaign.evidence_ids | length }}</td></tr>{% endfor %}
    </table></div>
    {% endif %}

    {% if cti.techniques %}
    <h3>{{ "Technique and countermeasure coverage" if report_lang == "en" else "Cobertura de técnicas y contramedidas" }}</h3>
    <div class="evidence-table"><table>
      <tr><th>TTP</th><th>{{ "Family" if report_lang == "en" else "Familia" }}</th><th>{{ "Tactics" if report_lang == "en" else "Tácticas" }}</th><th>{{ "Actors" if report_lang == "en" else "Actores" }}</th><th>D3FEND</th><th>{{ "State" if report_lang == "en" else "Estado" }}</th></tr>
      {% for technique in cti.techniques %}<tr class="cti-technique-row"><td><strong>{{ technique.technique_id }}</strong> · {{ technique.name }}</td><td>{{ technique.family }}</td><td>{{ technique.tactics | join(" · ") if technique.tactics else "N/D" }}</td><td>{{ technique.actors | join(" · ") if technique.actors else "N/D" }}</td><td>{% for control in technique.d3fend %}{{ control.id }}{% if not loop.last %} · {% endif %}{% else %}N/D{% endfor %}</td><td>{{ technique.state if report_lang == "en" else cti_states_es.get(technique.state, technique.state) }}</td></tr>{% endfor %}
    </table></div>
    {% endif %}

    {% if cti.evidence %}
    <details class="report-details">
      <summary>{{ "CTI evidence trace" if report_lang == "en" else "Traza de evidencia CTI" }} · {{ cti.evidence | length }}</summary>
      <div class="evidence-table"><table>
        <tr><th>#</th><th>{{ "Title" if report_lang == "en" else "Título" }}</th><th>{{ "State" if report_lang == "en" else "Estado" }}</th><th>{{ "Entities" if report_lang == "en" else "Entidades" }}</th><th>{{ "Relationship" if report_lang == "en" else "Relación" }}</th><th>URL</th></tr>
        {% for evidence in cti.evidence %}<tr><td><strong>{{ loop.index }}</strong></td><td>{{ evidence.title }}</td><td>{{ evidence.state if report_lang == "en" else cti_states_es.get(evidence.state, evidence.state) }}</td><td>{{ (evidence.actors + evidence.campaigns + evidence.techniques) | join(" · ") }}</td><td>{{ evidence.relationship if report_lang == "en" else cti_relationships_es.get(evidence.relationship, evidence.relationship) }}</td><td>{% if evidence.url %}<a class="compact-source-link" href="{{ evidence.url }}" title="{{ evidence.url }}">{{ "Open evidence" if report_lang == "en" else "Abrir evidencia" }} {{ loop.index }}</a>{% else %}N/D{% endif %}</td></tr>{% endfor %}
      </table></div>
    </details>
    {% endif %}
  </section>

  <section id="posture" class="report-subsection">
    <h3>{{ "Posture, evidence and control alignment" if report_lang == "en" else "Postura, evidencia y alineación de controles" }}</h3>
    <p class="small">
      {{ "Evidence is grouped by affected aspect. When one record maps to several frameworks it appears once, with all related frameworks and control families together. This does not measure compliance, maturity or control effectiveness." if report_lang == "en" else "La evidencia se agrupa por aspecto afectado. Cuando un registro se relaciona con varios marcos aparece una sola vez, acompañado por todos los frameworks y familias de control relacionados. Esto no mide cumplimiento, madurez ni eficacia de controles." }}
    </p>
    <div class="evidence-table framework-catalog-table">
      <table>
        <tr><th>Framework</th><th>{{ "Version" if report_lang == "en" else "Versión" }}</th><th>{{ "Domain" if report_lang == "en" else "Dominio" }}</th><th>{{ "Current-run state" if report_lang == "en" else "Estado en la corrida" }}</th><th>{{ "Mapped records" if report_lang == "en" else "Registros mapeados" }}</th></tr>
        {% for item in framework_summary.catalog %}
        <tr>
          <td>{% if item.reference_url %}<a href="{{ item.reference_url }}" target="_blank" rel="noreferrer">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}</td>
          <td>{{ item.version or "N/D" }}</td>
          <td>{{ item.domain }}</td>
          <td>{{ item.status_label }}{% if item.mapping_states %}<br><span class="small">{{ item.mapping_states | join(" · ") }}</span>{% endif %}</td>
          <td>{{ item.record_count }} · {{ item.mapping_count }} {{ "mapped cells" if report_lang == "en" else "celdas mapeadas" }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% if framework_summary.affected_axes %}
    <div class="framework-chip-row">
      {% for framework in framework_summary.related_frameworks %}<span>{{ framework }}</span>{% endfor %}
    </div>
    <div class="evidence-table framework-crosswalk-table">
      <table>
        <tr>
          <th>{{ "Affected aspect" if report_lang == "en" else "Aspecto afectado" }}</th>
          <th>{{ "Related frameworks" if report_lang == "en" else "Frameworks relacionados" }}</th>
          <th>{{ "Reference control families" if report_lang == "en" else "Familias de control de referencia" }}</th>
          <th>{{ "Unique evidence" if report_lang == "en" else "Evidencia única" }}</th>
          <th>{{ "Evidence" if report_lang == "en" else "Evidencia" }}</th>
        </tr>
        {% for item in framework_summary.affected_axes %}
        <tr>
          <td>{{ item.axis }}</td>
          <td><div class="framework-chip-row compact">{% for framework in item.frameworks %}<span>{{ framework }}</span>{% endfor %}</div></td>
          <td>
            {% for control_line in item.control_lines %}
            <div class="control-reference-line"><b>{{ control_line.framework }}:</b> {{ control_line.controls | join(", ") }}</div>
            {% endfor %}
          </td>
          <td><strong>{{ item.record_count }}</strong><br><span class="small">{{ item.validated_count }} {{ "validated" if report_lang == "en" else "validados" }} · {{ item.direct_count }} {{ "with a direct relationship" if report_lang == "en" else "con relación directa" }}</span></td>
          <td>
            {% for evidence in item.evidence %}
            <div>
              {% if evidence.url %}<a class="full-url" href="{{ evidence.url }}" target="_blank" rel="noreferrer">{{ evidence.url }}</a>{% else %}<span class="small">{{ evidence.title }}</span>{% endif %}
              <span class="small">{{ evidence.status }} · {{ evidence.relationship }} · {{ evidence.domain or evidence.source }}</span>
            </div>
            {% endfor %}
          </td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% else %}
    <div class="empty-state">{{ "No current-run records support a framework crosswalk." if report_lang == "en" else "Ningún registro de la corrida sustenta un cruce con frameworks." }}</div>
    {% endif %}
  </section>

  <section id="disarm" class="report-subsection">
    <h3>{{ "Narrative intelligence, disinformation and reputational risk" if report_lang == "en" else "Inteligencia de narrativas, desinformación y riesgo reputacional" }}</h3>
    <div class="scope-grid">
      <div>
        <h3>{{ "Framework reference" if report_lang == "en" else "Referencia de framework" }}</h3>
        <p class="small">{{ disinformation_summary.source }}{% if disinformation_summary.source_url %}: <a href="{{ disinformation_summary.source_url }}">URL</a>{% endif %}</p>
        <p><strong>{{ disinformation_summary.techniques_count }}</strong> {{ "techniques" if report_lang == "en" else "técnicas" }} · <strong>{{ disinformation_summary.tactics_count }}</strong> {{ "tactics" if report_lang == "en" else "tácticas" }}</p>
      </div>
      <div>
        <h3>{{ "Run activation" if report_lang == "en" else "Activación en la corrida" }}</h3>
        <p>{{ disinformation_summary.risk_statement }}</p>
      </div>
      <div>
        <h3>{{ "Top DISARM tactic families" if report_lang == "en" else "Familias tácticas DISARM principales" }}</h3>
        <ul class="compact-list">
          {% for item in disinformation_summary.tactic_counts %}
          <li>{{ item.name }} · {{ item.value }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% if disinformation_summary.all_rows %}
    <div class="evidence-table search-table">
      <table>
        <tr><th>{{ "Source" if report_lang == "en" else "Fuente" }}</th><th>{{ "Classification" if report_lang == "en" else "Clasificación" }}</th><th>{{ "Signal" if report_lang == "en" else "Señal" }}</th><th>{{ "Truth / coordination / state" if report_lang == "en" else "Veracidad / coordinación / estado" }}</th><th>URL</th></tr>
        {% for row in disinformation_summary.all_rows %}
        <tr><td>{{ row.source }}</td><td>{{ row.category }}</td><td>{{ row.title }}<br><span class="small">{{ row.review_reason }}</span></td><td>{{ row.tags }} · {{ row.confidence }}%</td><td>{% if row.evidence_url %}<a class="full-url" href="{{ row.evidence_url }}">{{ row.evidence_url }}</a>{% else %}<span class="small">n/a</span>{% endif %}</td></tr>
        {% endfor %}
      </table>
    </div>
    {% else %}
    <div class="empty-state">{{ "No related narrative signals in the available coverage." if report_lang == "en" else "Sin señales narrativas relacionadas en la cobertura disponible." }}</div>
    {% endif %}
  </section>
    </div>
  </details>

  <details id="relationships" class="report-module">
    <summary><span>03A</span><h2>{{ "Relationships, third parties and similar domains" if report_lang == "en" else "Relaciones, terceros y dominios similares" }}</h2><small>{{ relationship_risk.third_party.rows | length }} {{ "third parties" if report_lang == "en" else "terceros" }} · {{ relationship_risk.domain_abuse.rows | length }} {{ "similar domains" if report_lang == "en" else "dominios similares" }}</small></summary>
    <div class="report-module-body">
      {% include "relationship_risk_section.html.j2" %}
    </div>
  </details>

  <details id="scenarios" class="report-module">
    <summary><span>05</span><h2>{{ "Scenarios and recommended decisions" if report_lang == "en" else "Escenarios y decisiones recomendadas" }}</h2><small>{{ scenario_library.matches | length }} {{ "supported scenarios" if report_lang == "en" else "escenarios respaldados" }}</small></summary>
    <div class="report-module-body">
  <section id="escenarios-detail" class="report-subsection">
    <h3>{{ "Evidence-Activated Multi-Framework Scenarios" if report_lang == "en" else "Escenarios multi-framework activados por evidencia" }}</h3>
    <p class="small">{{ "Only scenarios supported by current-run evidence are included in this report." if report_lang == "en" else "Este informe incluye únicamente escenarios respaldados por evidencia de la corrida actual." }}</p>
    <div class="framework-grid compact-frameworks">
      {% for item in scenario_library.framework_counts %}
      <article class="framework-score">
        <span>{{ item.name }}</span>
        <strong>{{ item.value }}</strong>
        <small>{{ "mapped in active scenarios" if report_lang == "en" else "mapeados en escenarios activos" }}</small>
      </article>
      {% endfor %}
    </div>
    {% if scenario_library.matches %}
    <div class="scenario-decision-report technical-scenarios">
      {% for match in scenario_library.matches %}
      <article class="scenario-report-card">
        <div class="scenario-head"><span class="badge">{{ match.id }}</span><strong>{{ match.confidence }}%</strong></div>
        <h3>{{ match.title }}</h3>
        <div class="framework-chip-row">
          <span>{{ match.frameworks.attack }}</span>
          <span>{{ match.frameworks.d3fend }}</span>
          <span>{{ match.frameworks.atlas }}</span>
          <span>{{ match.frameworks.disarm }}</span>
        </div>
        <p><strong>{{ "Domains" if report_lang == "en" else "Dominios" }}:</strong> {{ match.domains_label }} · <strong>{{ "Evidence" if report_lang == "en" else "Evidencia" }}:</strong> {{ match.evidence_label }} · <strong>{{ "Criteria" if report_lang == "en" else "Criterios" }}:</strong> {{ match.reasons_label }}</p>
        <p><strong>{{ "Criteria" if report_lang == "en" else "Criterio" }}:</strong> {{ match.criteria }}</p>
        <p><strong>{{ "Directive question" if report_lang == "en" else "Pregunta directiva" }}:</strong> {{ match.question }}</p>
        <p><strong>{{ "Decision possibility" if report_lang == "en" else "Posibilidad de decisión" }}:</strong> {{ match.decision }}</p>
        {% if match.recommendation %}<p><strong>{{ "Recommendation option" if report_lang == "en" else "Opción de recomendación" }}:</strong> {{ match.recommendation }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">{{ "No evidence-supported possibility crossed the current-run threshold." if report_lang == "en" else "Ninguna posibilidad soportada por evidencia cruzó el umbral de la corrida actual." }}</div>
    {% endif %}
  </section>

  <section id="hallazgos" class="report-subsection">
    <h3>{{ "Prioritized Findings and Action Evidence" if report_lang == "en" else "Hallazgos priorizados y evidencia de acción" }}</h3>
    {% for finding in top_findings %}
    <article class="finding">
      <div class="finding-head">
        <div>
          <h3>{{ loop.index }}. {{ finding.title }}</h3>
          <span class="badge {{ 'demo' if finding.demo else 'real' }}">{{ ("DEMO/SIMULATED" if report_lang == "en" else "DEMO/SIMULADO") if finding.demo else technical_terms.authorized_collection }}</span>
          <span class="badge {{ finding.evidence_status }}">{{ finding.evidence_status }}</span>
          <span class="badge">{{ finding.matrix_label }}</span>
          <p class="small">{{ "Category" if report_lang == "en" else "Categoría" }}: {{ finding.category }} | {{ "Owner" if report_lang == "en" else "Responsable" }}: {{ finding.owner }} | {{ "Matrix score" if report_lang == "en" else "Puntaje de matriz" }}: {{ finding.matrix_score }}</p>
        </div>
        <div class="score">{{ "%.1f"|format(finding.residual_risk) }}</div>
      </div>
      <p><strong>{{ "Evidence" if report_lang == "en" else "Evidencia" }}:</strong> {{ finding.evidence | join(" ") }}</p>
      <ul>{% for recommendation in finding.recommendations %}<li>{{ recommendation }}</li>{% endfor %}</ul>
    </article>
    {% endfor %}
  </section>

  <section id="plan" class="report-subsection">
    <h3>{{ "Technical Work Plan Traceability" if report_lang == "en" else "Trazabilidad técnica del plan de trabajo" }}</h3>
    <p class="small">{{ work_plan.summary }}</p>
    <div class="callout compact"><strong>{{ "Decision rule" if report_lang == "en" else "Regla de decisión" }}:</strong> {{ work_plan.decision_gate }}</div>
    {% if work_plan["items"] %}
    <div class="evidence-table plan-table">
      <table>
        <tr>
          <th>ID</th>
          <th>{{ "Priority" if report_lang == "en" else "Prioridad" }}</th>
          <th>{{ "Time" if report_lang == "en" else "Tiempo" }}</th>
          <th>{{ "Responsible roles" if report_lang == "en" else "Roles responsables" }}</th>
          <th>{{ "Scenario rationale" if report_lang == "en" else "Sustento del escenario" }}</th>
          <th>{{ "Basis" if report_lang == "en" else "Base" }}</th>
          <th>{{ "Control alignment" if report_lang == "en" else "Alineación de controles" }}</th>
          <th>{{ "Validation" if report_lang == "en" else "Validación" }}</th>
          <th>{{ "Evidence URLs" if report_lang == "en" else "URLs de evidencia" }}</th>
        </tr>
        {% for item in work_plan["items"] %}
        <tr>
          <td><strong>{{ item.id }}</strong><br>{{ item.title }}</td>
          <td>{{ item.priority }}</td>
          <td>{{ item.timeframe }}</td>
          <td>{{ item.owners | join(" · ") }}</td>
          <td>{{ item.argument }}</td>
          <td>{{ item.basis }}{% if item.scenarios %}<br>{{ "Scenarios" if report_lang == "en" else "Escenarios" }}: {{ item.scenarios | join(", ") }}{% endif %}</td>
          <td>
            {% for mapping in item.control_mappings %}
            <strong>{{ mapping.framework }}</strong> · {{ mapping.aspect }}{% if mapping.controls %}: {{ mapping.controls | join(", ") }}{% endif %}{% if not loop.last %}<br>{% endif %}
            {% else %}
            <span class="small">{{ "No evidence-linked control crosswalk." if report_lang == "en" else "Sin cruce de control enlazado a la evidencia." }}</span>
            {% endfor %}
          </td>
          <td>{{ item.validation }}</td>
          <td>
            {% for url in item.evidence_urls %}
            <a class="full-url" href="{{ url }}">{{ url }}</a>{% if not loop.last %}<br>{% endif %}
            {% else %}
            <span class="small">{{ "No direct URL in this workstream." if report_lang == "en" else "Sin URL directa en este frente." }}</span>
            {% endfor %}
          </td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% else %}
    <div class="empty-state decision-gate">{{ work_plan.decision_gate }}</div>
    {% endif %}
  </section>
    </div>
  </details>

  <details id="evidencia" class="report-module">
    <summary><span>07</span><h2>{{ "Limitations and evidence appendix" if report_lang == "en" else "Limitaciones y anexo de evidencia" }}</h2><small>{{ evidence_rows | length }} {{ "records" if report_lang == "en" else "registros" }}</small></summary>
    <div class="report-module-body">
    <h3>{{ "URL-by-URL Evidence" if report_lang == "en" else "Evidencia URL por URL" }}</h3>
    <p class="small">{{ "The table separates the review URL, visual preview when available, relationship to the scope and validation note. Evidence can still require analyst confirmation before action." if report_lang == "en" else "La tabla separa URL de revisión, vista previa cuando existe, relación con el alcance y nota de validación. La evidencia puede requerir confirmación analítica antes de ejecutar acciones." }}</p>
    <div class="evidence-type-grid">
      {% for item in evidence_type_summary %}
      <div class="evidence-type-item"><span>{{ item.label }}</span><strong>{{ item.count }}</strong></div>
      {% endfor %}
    </div>
    <div class="claim-grid technical-claims">
      {% for row in claim_evidence_rows %}
      <details id="claim-{{ loop.index }}" class="claim-card claim-detail report-detail-card">
        <summary class="claim-card-summary">
          <span class="badge">{{ "Claim" if report_lang == "en" else "Afirmación" }} {{ loop.index }}</span>
          <strong class="claim-statement">{{ row.what_found }}</strong>
          <span class="badge {{ row.status }}">{{ row.status }}</span>
          <span>{{ "Confidence" if report_lang == "en" else "Confianza" }} {{ row.confidence }}%</span>
        </summary>
        <div class="claim-detail-body">
        <h3>{{ row.what_found }}</h3>
        <div class="claim-reading-grid">
          <p><strong>{{ "What it demonstrates" if report_lang == "en" else "Qué demuestra" }}</strong><span>{{ row.what_demonstrates }}</span></p>
          <p><strong>{{ "What it does not demonstrate" if report_lang == "en" else "Qué no demuestra" }}</strong><span>{{ row.what_not_demonstrates }}</span></p>
          <p><strong>{{ "How it was validated" if report_lang == "en" else "Cómo se validó" }}</strong><span>{{ row.how_validated }}</span></p>
          <p><strong>{{ "Decision" if report_lang == "en" else "Decisión" }}</strong><span>{{ row.decision }}</span></p>
          <p><strong>{{ "Owner" if report_lang == "en" else "Responsable" }}</strong><span>{{ row.owner }}</span></p>
          <p><strong>{{ "Closure criterion" if report_lang == "en" else "Criterio de cierre" }}</strong><span>{{ row.closure_criteria }}</span></p>
        </div>
        <details class="claim-evidence-detail">
          <summary>{{ row.evidence_count }} {{ "evidence references" if report_lang == "en" else "referencias de evidencia" }}</summary>
          {% for evidence in row.evidence %}
          <div class="evidence-reference">
            <div><strong>{{ "Type" if report_lang == "en" else "Tipo" }}</strong><span>{{ evidence.evidence_type }}</span></div>
            <div><strong>{{ "Entity" if report_lang == "en" else "Entidad" }}</strong><span>{{ evidence.entity or "N/D" }}</span></div>
            <div><strong>{{ "Relation" if report_lang == "en" else "Relación" }}</strong><span>{{ evidence.relation_to_claim }}</span></div>
            <div><strong>{{ "Collected" if report_lang == "en" else "Recolectado" }}</strong><span>{{ evidence.collected_at }}</span></div>
            <div><strong>TLP / PAP</strong><span>{{ evidence.TLP }} · {{ evidence.PAP }}</span></div>
            <div class="wide"><strong>URL</strong>{% if evidence.canonical_url %}<a class="full-url" href="{{ evidence.canonical_url }}">{{ evidence.canonical_url }}</a>{% else %}<span>N/D</span>{% endif %}</div>
          </div>
          {% else %}
          <p class="small">{{ "No linked evidence; the claim remains supported/candidate and cannot be presented as validated." if report_lang == "en" else "Sin evidencia enlazada; la afirmación permanece respaldada/candidata y no puede presentarse como validada." }}</p>
          {% endfor %}
        </details>
        <p><strong>{{ "Limitations" if report_lang == "en" else "Limitaciones" }}:</strong> {{ row.limitations | join(" · ") if row.limitations else ("None documented" if report_lang == "en" else "Sin limitaciones documentadas") }}</p>
        <p><strong>{{ "Contradictions" if report_lang == "en" else "Contradicciones" }}:</strong> {{ row.contradictions | length }}</p>
        </div>
      </details>
      {% endfor %}
    </div>
    <div class="evidence-table audit-table technical-audit-table">
      <table>
        <tr><th>{{ "Evidence" if report_lang == "en" else "Evidencia" }}</th><th>{{ "Type and source" if report_lang == "en" else "Tipo y fuente" }}</th><th>{{ "Collected result" if report_lang == "en" else "Resultado recolectado" }}</th><th>{{ "Relationship and validation" if report_lang == "en" else "Relación y validación" }}</th><th>{{ "Technical mapping" if report_lang == "en" else "Mapeo técnico" }}</th><th>{{ "Tags" if report_lang == "en" else "Etiquetas" }}</th><th>{{ "Source" if report_lang == "en" else "Fuente" }}</th></tr>
        {% for row in evidence_rows %}
        <tr>
          <td>
            {% if row.preview_url %}
            <a class="evidence-thumb-link" href="#evidence-preview-{{ loop.index }}" aria-label="{{ 'Expand evidence preview' if report_lang == 'en' else 'Ampliar vista previa de evidencia' }}">
              <img class="evidence-thumb" src="{{ row.preview_url }}" alt="{{ 'Evidence preview' if report_lang == 'en' else 'Vista previa de evidencia' }}" loading="lazy" decoding="async" onerror="this.remove()">
              <span>{{ "Expand" if report_lang == "en" else "Ampliar" }}</span>
            </a>
            <div id="evidence-preview-{{ loop.index }}" class="preview-lightbox" role="dialog" aria-label="{{ 'Expanded evidence preview' if report_lang == 'en' else 'Vista previa de evidencia ampliada' }}">
              <a class="preview-backdrop" href="#evidencia" aria-label="{{ 'Close preview' if report_lang == 'en' else 'Cerrar vista previa' }}"></a>
              <figure>
                <a class="preview-close" href="#evidencia">{{ "Close" if report_lang == "en" else "Cerrar" }}</a>
                <img src="{{ row.preview_url }}" alt="{{ row.title }}" loading="lazy" decoding="async" onerror="this.remove()">
                <figcaption>
                  <strong>{{ row.title }}</strong>
                  <span>{{ row.relationship }} · {{ row.validation }}</span>
                  {% if row.evidence_url %}<a class="full-url" href="{{ row.evidence_url }}">{{ row.evidence_url }}</a>{% endif %}
                </figcaption>
              </figure>
            </div>
            {% else %}
            <span class="evidence-mini">{{ "URL" if row.evidence_url else "n/a" }}</span>
            {% endif %}
          </td>
          <td><strong>{{ row.evidence_type_label }}</strong><span>{{ row.source }}</span></td>
          <td><strong>{{ row.category_label }}</strong><span>{{ row.title }}</span><small>{{ "Publication date" if report_lang == "en" else "Fecha de publicación" }}: {{ row.published_date or ("Not available; period membership unverified" if report_lang == "en" else "No disponible; pertenencia al período no verificable") }}</small></td>
          <td><strong>{{ row.relationship }}</strong><span>{{ row.validation }}</span></td>
          <td>
            <span><strong>{{ "Actor" if report_lang == "en" else "Actor" }}:</strong> {{ row.actor or ("unattributed" if report_lang == "en" else "sin atribución") }}</span>
            <span><strong>ATT&CK:</strong> {{ row.technique or ("unmapped" if report_lang == "en" else "sin mapeo") }}</span>
            {% if row.cve %}<span><strong>CVE:</strong> {{ row.cve }}</span>{% endif %}
          </td>
          <td>{{ row.tags or ("No public tags" if report_lang == "en" else "Sin etiquetas públicas") }}</td>
          <td>{% if row.evidence_url %}<a class="compact-source-link" href="{{ row.evidence_url }}" title="{{ row.evidence_url }}">{{ row.evidence_url_label }}</a>{% else %}<span class="small">{{ "no direct URL" if report_lang == "en" else "sin URL directa" }}</span>{% endif %}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
    </div>
  </details>

  <script>
    (() => {
      const revealTarget = () => {
        if (!location.hash) return;
        const target = document.querySelector(location.hash);
        if (!target) return;
        let parent = target.closest("details");
        while (parent) {
          parent.open = true;
          parent = parent.parentElement ? parent.parentElement.closest("details") : null;
        }
      };
      addEventListener("hashchange", revealTarget);
      revealTarget();
    })();
  </script>

  <footer>{{ "CyberDecisionEngine Technical Report. Designed by Edwin Peñuela." if report_lang == "en" else "Informe técnico CyberDecisionEngine. Diseñado por Edwin Peñuela." }}</footer>
</main>
</body>
</html>
