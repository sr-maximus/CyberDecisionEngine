<!doctype html>
{% set report_lang = organization.language | default("es") %}
{% set scenario_library = scenario_library | default({"reference_template_count": 0, "defined_count": 0, "executable_count": 0, "tested_count": 0, "active_count": 0, "sources": [], "framework_counts": [], "matches": [], "status": ("No scenario context was attached to this report." if report_lang == "en" else "No se adjuntó contexto de escenarios a este informe.")}, true) %}
{% set domain_reading_rows = domain_reading_rows | default([], true) %}
{% set intelligence_modules = intelligence_modules | default([], true) %}
{% set disinformation_summary = disinformation_summary | default({"risk_statement": ("No disinformation context was attached to this report." if report_lang == "en" else "No se adjuntó contexto de desinformación a este informe."), "active_evidence": 0, "active_rows": [], "tactic_counts": [], "techniques_count": 0, "tactics_count": 0, "source": "DISARM Foundation", "source_url": none}, true) %}
{% set brand_fraud_summary = brand_fraud_summary | default({"total_mentions": 0, "positive": 0, "neutral": 0, "negative": 0, "fraud_pressure_label": "0%", "reputation_impact": 0, "domain_rows": [], "lookalikes": [], "mentions": [], "narrative": ""}, true) %}
{% set model_summary = model_summary | default({"purpose": metrics.risk_methodology.purpose, "formulas": [], "assumptions": []}, true) %}
{% set work_plan = work_plan | default({"status": "not_supported", "summary": "", "decision_gate": "", "items": []}, true) %}
{% set methodology_summary = methodology_summary | default({"steps": [], "percent_note": "", "risk_note": "", "calculation_basis": []}, true) %}
{% set vuln_intel = metrics.vulnerability_intelligence | default({"confirmed_cves": 0, "kev_matches": 0, "observed_technologies": 0, "surface_assets": 0, "patch_focus": "", "method": "", "rows": []}, true) %}
{% set geo_intel = metrics.geographic_intelligence | default({"incorporation_country": organization.country, "incorporation_country_label": organization.country, "declared_countries_of_operation": [], "declared_country_labels": [], "country_inventory": [], "evidence_supported_countries": [], "contextual_country_mentions": [], "method": "", "limitations": ""}, true) %}
{% set sector_intel = metrics.sector_intelligence | default({"declared_sectors": [organization.sector], "declared_subsector": organization.subsector, "evidence_supported_sectors": [], "contextual_sector_mentions": [], "method": "", "limitations": ""}, true) %}
{% set public_entities = metrics.public_entity_intelligence | default({"total_candidates": 0, "emails": 0, "phones": 0, "people_profiles": 0, "rows": [], "method": ""}, true) %}
{% set layered_risk = metrics.layered_scenario_risk | default({"status": "no_data", "model_version": "CDE-LAYERED-SCENARIO-1.0", "scenarios": []}, true) %}
{% set prospective = metrics.prospective_attack_risk | default({"status": "insufficient_evidence", "model_version": "N/D", "pressure_index_30d": none, "evidence_confidence": 0, "trend": {"direction": "insufficient_evidence", "change_ratio": none}, "attack_probability": {"value": none, "status": "not_calibrated"}, "drivers": [], "scenarios": []}, true) %}
{% set relationship_risk = metrics.relationship_risk_intelligence | default({"third_party": {"status": "no_data", "rows": []}, "domain_abuse": {"status": "no_data", "rows": []}, "competitive_context": {"status": "no_data", "rows": []}}, true) %}
{% set relationship_status_es = {'evidence_supported_signal': 'Señal respaldada por evidencia', 'context_only': 'Solo contexto', 'declared_unobserved': 'Declarada, no observada', 'suspicious_observed_signal': 'Señal observada que requiere validación', 'similar_domain_observed': 'Dominio similar observado', 'evidence_represented': 'Representado por evidencia', 'declared_no_evidence': 'Declarado sin evidencia en la corrida'} %}
{% set relationship_status_en = {'evidence_supported_signal': 'Evidence-supported signal', 'context_only': 'Context only', 'declared_unobserved': 'Declared, not observed', 'suspicious_observed_signal': 'Observed signal requiring validation', 'similar_domain_observed': 'Observed similar domain', 'evidence_represented': 'Represented by evidence', 'declared_no_evidence': 'Declared without run evidence'} %}
{% set relationship_basis_es = {'declared_supplier': 'Proveedor declarado', 'public_relationship_reference': 'Relación pública observada'} %}
{% set relationship_basis_en = {'declared_supplier': 'Declared supplier', 'public_relationship_reference': 'Observed public relationship'} %}
{% set variation_es = {'character_substitution': 'Sustitución de carácter', 'character_deletion': 'Eliminación de carácter', 'character_insertion': 'Inserción de carácter', 'transposition': 'Transposición', 'confusable_character': 'Carácter visualmente confundible', 'same_label_different_tld': 'Mismo nombre con otro TLD', 'visual_character_substitution': 'Sustitución por carácter visualmente similar', 'character_insertion_or_deletion': 'Inserción o eliminación de carácter', 'character_substitution_or_transposition': 'Sustitución o transposición de carácter', 'brand_modifier': 'Marca con modificador comercial', 'lexical_similarity': 'Similitud léxica'} %}
{% set variation_en = {'character_substitution': 'Character substitution', 'character_deletion': 'Character deletion', 'character_insertion': 'Character insertion', 'transposition': 'Transposition', 'confusable_character': 'Visually confusable character', 'same_label_different_tld': 'Same label with another TLD', 'visual_character_substitution': 'Visually confusable character substitution', 'character_insertion_or_deletion': 'Character insertion or deletion', 'character_substitution_or_transposition': 'Character substitution or transposition', 'brand_modifier': 'Brand with a commercial modifier', 'lexical_similarity': 'Lexical similarity'} %}
{% set attack_surface_inventory = attack_surface_inventory | default({"summary": "", "rows": []}, true) %}
{% set evidence_preview_gallery = evidence_preview_gallery | default([], true) %}
{% set strategic_labels_en = {'cyber_geopolitics': 'Geopolitics, public policy and state threat', 'cyber_economy': 'Digital economy, fraud and financial pressure', 'cyber_human': 'Human factors, digital trust and social manipulation', 'cyber_technology': 'Technology dependency, vulnerabilities and attack surface', 'cyber_resilience': 'Physical, energy and environmental resilience and digital continuity', 'cyber_legal': 'Regulation, privacy, compliance and cyber liability', 'cyber_rivalry': 'Digital rivalry and competitive cybersecurity pressure', 'cyber_new_entrants': 'New digital entrants and attack-surface expansion', 'cyber_suppliers': 'Cyber power and dependency of suppliers and third parties', 'cyber_customers': 'Security power and demands of customers, partners and channels', 'cyber_substitutes': 'Technology substitution and cyber-risk displacement'} %}
{% set cti = metrics.cti | default({}, true) %}
{% set cti_overview = cti.overview | default({}, true) %}
{% set cti_states_es = {'OBSERVED': 'Observado', 'INFERRED': 'Inferido', 'RELATED': 'Relacionado', 'REFERENCE': 'Referencia'} %}
{% set cti_bands_es = {'critical': 'Crítica', 'high': 'Alta', 'medium': 'Media', 'low': 'Baja'} %}
{% set cti_relationships_es = {'contextual': 'Contextual', 'related': 'Relacionada', 'direct': 'Directa', 'reference': 'Referencia'} %}
{% set snapshot_detail = true %}
{% set snapshot_collapsible = true %}
<html lang="{{ report_lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="cde:run-id" content="{{ decision_snapshot.report_context.run_id }}">
  <meta name="cde:snapshot-hash" content="{{ decision_snapshot.snapshot_hash }}">
  <title>CyberDecisionEngine Technical - {{ organization.name }}</title>
  <style>{{ css }}</style>
</head>
<body class="technical-report-v2">
<main>
  <header class="report-cover">
    <div class="eyebrow">CyberDecisionEngine | {{ "Technical evidence report" if report_lang == "en" else "Informe técnico de evidencia" }}</div>
    <h1>{{ "Technical cyber intelligence report" if report_lang == "en" else "Informe técnico de ciberinteligencia" }} — {{ decision_snapshot.report_context.group_name or organization.name }}</h1>
    <p>{{ "Traceable technical detail for analysis, validation and response." if report_lang == "en" else "Detalle técnico trazable para análisis, validación y respuesta." }}</p>
    <div class="meta report-cover-meta">
      <div><span>{{ "Organization" if report_lang == "en" else "Organización" }}</span><strong>{{ decision_snapshot.report_context.group_name or organization.name }}</strong></div>
      <div><span>{{ "Sector" if report_lang == "en" else "Sector" }}</span><strong>{{ display_sector }}</strong></div>
      <div><span>{{ "Country" if report_lang == "en" else "País" }}</span><strong>{{ display_country }}</strong></div>
      <div><span>{{ "Analysis range" if report_lang == "en" else "Rango analizado" }}</span><strong>{{ report_scope.analysis_window }}</strong></div>
      {% if report_scope.analysis_period %}<div><span>{{ "Evidence dates" if report_lang == "en" else "Fechas de la evidencia" }}</span><strong>{{ report_scope.analysis_period.dated_in_period_records }} {{ "within period" if report_lang == "en" else "del período" }} · {{ report_scope.analysis_period.undated_records }} {{ "undated, included" if report_lang == "en" else "sin fecha, incluidas" }}</strong><p>{{ "Undated evidence is analyzed, but its membership in the period is unverified. Present-day observations do not establish historical conditions." if report_lang == "en" else "La evidencia sin fecha se analiza, pero su pertenencia al período no es verificable. Las observaciones actuales no demuestran condiciones históricas." }}</p><p>{{ report_scope.analysis_period.out_of_period_records }} {{ "dated records outside the period, excluded from analysis and retained for traceability." if report_lang == "en" else "registros fechados fuera del período, excluidos del análisis y conservados para trazabilidad." }}</p></div>{% endif %}
      <div><span>{{ report_display.label }}</span><strong>{{ report_display.datetime }}</strong></div>
      <div>{% if report_scope.primary_domains %}<span>{{ "Analysed domains" if report_lang == "en" else "Dominios analizados" }}</span><strong>{{ report_scope.primary_domains | length }}</strong>{% else %}<span>{{ "Analysed targets" if report_lang == "en" else "Objetivos analizados" }}</span><strong>{{ decision_snapshot.analyzed_entities | length }}</strong>{% endif %}</div>
    </div>
  </header>

  <nav class="report-nav report-nav-seven report-nav-eight" aria-label="{{ 'Technical report navigation' if report_lang == 'en' else 'Navegación del informe técnico' }}">
    <a href="#decision">{{ "Decision" if report_lang == "en" else "Decisión" }}</a>
    <a href="#resumen">{{ "Exposure and risk" if report_lang == "en" else "Exposición y riesgo" }}</a>
    <a href="#threat-matrix">{{ "Threat matrix" if report_lang == "en" else "Matriz de amenazas" }}</a>
    <a href="#strategy">PESTEL-Porter</a>
    <a href="#scenarios">{{ "Scenarios" if report_lang == "en" else "Escenarios" }}</a>
    <a href="#posture">{{ "Posture" if report_lang == "en" else "Postura" }}</a>
    <a href="#relationships">{{ "Relationships" if report_lang == "en" else "Relaciones" }}</a>
    <a href="#evidencia">{{ "Evidence" if report_lang == "en" else "Evidencia" }}</a>
  </nav>

  {% include "decision_snapshot.html.j2" %}

  <details id="resumen" class="report-module">
    <summary><span>02</span><h2>{{ "Exposure and principal risks" if report_lang == "en" else "Exposición y riesgos principales" }}</h2><small>{{ processing_summary.unique_records | default(raw_events|length) }} {{ "unique records" if report_lang == "en" else "registros únicos" }}</small></summary>
    <div class="report-module-body">
    <h3>{{ "Technical summary" if report_lang == "en" else "Resumen técnico" }}</h3>
    <div class="kpi-grid">
      <div class="metric"><span>{{ "Unique records" if report_lang == "en" else "Registros únicos" }}</span><strong>{{ processing_summary.unique_records | default(raw_events|length) }}</strong><small>{{ processing_summary.raw_records_collected | default(raw_events|length) }} {{ "raw" if report_lang == "en" else "brutos" }}</small></div>
      <div class="metric"><span>{{ "Calculated risk findings" if report_lang == "en" else "Hallazgos de riesgo calculados" }}</span><strong>{{ risk_findings|length }}</strong></div>
      <div class="metric"><span>{{ "Fraud pressure" if report_lang == "en" else "Presión de fraude" }}</span>{% if metrics.fraud_pressure > 0 %}<strong>{{ "%.2f"|format(metrics.fraud_pressure) }}</strong>{% else %}<strong>{{ "No validated signals" if report_lang == "en" else "Sin señales validadas" }}</strong><small>{{ "within available coverage" if report_lang == "en" else "en la cobertura disponible" }}</small>{% endif %}</div>
      <div class="metric"><span>{{ "Max residual risk" if report_lang == "en" else "Riesgo residual máx." }}</span><strong>{% if risk_digest.max_residual is not none %}{{ "%.1f"|format(risk_digest.max_residual) }}{% else %}N/D{% endif %}</strong><small>{{ risk_digest.max_label }}</small></div>
      <div class="metric"><span>{{ "Window" if report_lang == "en" else "Ventana" }}</span><strong>{{ report_scope.analysis_window }}</strong></div>
    </div>
    <div class="callout">
      {{ "This file preserves operational detail for SOC, CTI, fraud, GRC, legal and response. The executive report prioritizes decisions; this report prioritizes traceability, method and evidence." if report_lang == "en" else "Este archivo conserva detalle operativo para SOC, CTI, fraude, GRC, legal y respuesta. El informe ejecutivo prioriza decisiones; este informe prioriza trazabilidad, método y evidencia." }}
    </div>
    <details class="report-subdetail">
      <summary><strong>{{ "Cyber-risk heat radar" if report_lang == "en" else "Radar-calor de ciberriesgos" }}</strong><span>{{ metrics.risk_heat_radar.rows | length }} {{ "risk categories" if report_lang == "en" else "categorías de riesgo" }}</span></summary>
      <div class="report-subdetail-body">
        <p>{{ metrics.risk_heat_radar.how_to_read }}</p>
        {% include 'evidence_review_outcome.html.j2' %}
        <p class="risk-reading-note"><strong>{{ "Interpretation rule" if report_lang == "en" else "Regla de lectura" }}:</strong> {{ "N/D is insufficient evidence, not zero risk." if report_lang == "en" else "N/D corresponde a evidencia insuficiente, no a riesgo cero." }}</p>
        <div class="risk-radar-layout technical-risk-radar">
          <div class="risk-radar-chart">{{ radars.risk_heat | safe }}</div>
          <div class="report-table-scroll risk-heat-table"><table><thead><tr><th>#</th><th>{{ "Risk" if report_lang == "en" else "Riesgo" }}</th><th>{{ "Score" if report_lang == "en" else "Puntaje" }}</th><th>{{ "Findings / evidence" if report_lang == "en" else "Hallazgos / evidencia" }}</th><th>{{ "Decision" if report_lang == "en" else "Decisión" }}</th></tr></thead><tbody>{% for row in metrics.risk_heat_radar.rows %}<tr><td><span class="risk-index {{ row.heat }}">{{ row.index }}</span></td><td><strong>{{ row.name }}</strong></td><td>{% if row.score is not none and row.value_status != "no_data" %}{{ "%.1f"|format(row.score * 100) }}/100{% else %}N/D{% endif %}</td><td>{{ row.finding_count }} / {{ row.evidence_count }}</td><td>{{ row.decision }}</td></tr>{% endfor %}</tbody></table></div>
        </div>
      </div>
    </details>
    <div class="coverage-grid technical-coverage">
      {% for module in intelligence_modules %}
      <article class="coverage-card {{ module.tone }}">
        <div class="coverage-head"><span>{{ module.title }}</span><strong>{{ module.status }}</strong></div>
        <div class="module-value">{{ module.value }} <small>{{ module.unit }}</small></div>
        <p>{{ module.detail }}</p>
      </article>
      {% endfor %}
    </div>
    </div>
  </details>

  {% set footprint_detail = true %}
  {% include "technology_footprint.html.j2" %}

  <details id="alcance" class="report-module">
    <summary><span>02A</span><h2>{{ "Scope, Data and Definitions" if report_lang == "en" else "Alcance, datos y definiciones" }}</h2><small>{{ report_scope.primary_domains | length }} {{ "domains" if report_lang == "en" else "dominios" }}</small></summary>
    <div class="report-module-body">
    <div class="callout">
      <strong>{{ "How to interpret" if report_lang == "en" else "Cómo interpretar" }}:</strong>
      {{ "raw data is normalized into unique records; contextual records orient analysis; direct/validated evidence can support findings; findings feed calculated risk; only validated materialized activity is a confirmed incident." if report_lang == "en" else "los datos brutos se normalizan en registros únicos; lo contextual orienta; la evidencia directa/validada puede sustentar hallazgos; los hallazgos alimentan riesgo calculado; solo actividad materializada validada es incidente confirmado." }}
    </div>
    <div class="scope-grid">
      <div>
        <h3>{{ "Primary scope" if report_lang == "en" else "Alcance primario" }}</h3>
        <div class="chip-list">
          {% for domain in report_scope.primary_domains %}<span class="chip">{{ domain }}</span>{% else %}<span class="chip muted">{{ "No persisted domain" if report_lang == "en" else "Sin dominio persistido" }}</span>{% endfor %}
        </div>
      </div>
      <div>
        <h3>{{ "Comparison scope" if report_lang == "en" else "Alcance comparativo" }}</h3>
        <div class="chip-list">
          {% for domain in report_scope.comparison_domains %}<span class="chip alt">{{ domain }}</span>{% else %}<span class="chip muted">{{ "No benchmark domains configured" if report_lang == "en" else "Sin dominios benchmark configurados" }}</span>{% endfor %}
        </div>
      </div>
      <div>
        <h3>{{ "Data basis" if report_lang == "en" else "Base de datos usada" }}</h3>
        <p class="small">{{ report_scope.data_basis }}</p>
        <p class="small">{{ report_scope.comparison_basis }}</p>
      </div>
      <div>
        <h3>{{ "Declared geography" if report_lang == "en" else "Geografía declarada" }}</h3>
        <p class="small"><strong>{{ "Reference country" if report_lang == "en" else "País de referencia" }}:</strong> {{ geo_intel.incorporation_country_label or geo_intel.incorporation_country or "N/D" }}</p>
        <div class="chip-list">{% for country in geo_intel.declared_country_labels %}<span class="chip">{{ country }}</span>{% else %}<span class="chip muted">{{ "Not declared" if report_lang == "en" else "No declarada" }}</span>{% endfor %}</div>
      </div>
      <div>
        <h3>{{ "Declared sector scope" if report_lang == "en" else "Alcance sectorial declarado" }}</h3>
        <div class="chip-list">{% for sector in sector_intel.declared_sectors %}<span class="chip">{{ sector }}</span>{% else %}<span class="chip muted">{{ "Not declared" if report_lang == "en" else "No declarado" }}</span>{% endfor %}</div>
        {% if sector_intel.declared_subsector %}<p class="small"><strong>{{ "Subsector" if report_lang == "en" else "Subsector" }}:</strong> {{ sector_intel.declared_subsector }}</p>{% endif %}
      </div>
    </div>
    {% if geo_intel.country_inventory %}
    <h3>{{ "Location and geographic evidence relationships" if report_lang == "en" else "Ubicación y relaciones geográficas de evidencia" }}</h3>
    <p class="small">{{ geo_intel.method }} {{ geo_intel.limitations }}</p>
    <div class="evidence-table comparison-table">
      <table>
        <tr><th>{{ "Country" if report_lang == "en" else "País" }}</th><th>{{ "State" if report_lang == "en" else "Estado" }}</th><th>{{ "Records / assured / official" if report_lang == "en" else "Registros / asegurados / oficiales" }}</th><th>{{ "What it demonstrates" if report_lang == "en" else "Qué demuestra" }}</th><th>{{ "What it does not demonstrate" if report_lang == "en" else "Qué no demuestra" }}</th><th>URL</th></tr>
        {% for row in geo_intel.country_inventory %}
        <tr><td>{{ row.country }}</td><td>{% if report_lang == "en" %}{{ "Supported operational context" if row.status == "supported_operational_context" else "Declared and mentioned" if row.status == "declared_and_mentioned" else "Declared scope" if row.status == "declared_scope" else "Related mention" }}{% else %}{{ "Contexto operativo sustentado" if row.status == "supported_operational_context" else "Declarado y mencionado" if row.status == "declared_and_mentioned" else "Alcance declarado" if row.status == "declared_scope" else "Mención relacionada" }}{% endif %}</td><td>{{ row.records }} / {{ row.assured_records }} / {{ row.official_records }}</td><td>{{ row.what_it_demonstrates }}</td><td>{{ row.what_it_does_not_demonstrate }}</td><td>{% for url in row.evidence_urls[:3] %}<a class="compact-source-link" href="{{ url }}" title="{{ url }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }} {{ loop.index }}</a>{% if not loop.last %}<br>{% endif %}{% else %}<span class="muted">N/D</span>{% endfor %}</td></tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}
    {% if sector_intel.evidence_supported_sectors %}
    <h3>{{ "Sector evidence relationships" if report_lang == "en" else "Relaciones sectoriales de evidencia" }}</h3>
    <p class="small">{{ sector_intel.method }} {{ sector_intel.limitations }}</p>
    <div class="evidence-table comparison-table">
      <table>
        <tr><th>{{ "Sector" if report_lang == "en" else "Sector" }}</th><th>{{ "State" if report_lang == "en" else "Estado" }}</th><th>{{ "Records / direct / assured" if report_lang == "en" else "Registros / directos / asegurados" }}</th><th>{{ "What it demonstrates" if report_lang == "en" else "Qué demuestra" }}</th><th>{{ "What it does not demonstrate" if report_lang == "en" else "Qué no demuestra" }}</th><th>{{ "Sources" if report_lang == "en" else "Fuentes" }}</th></tr>
        {% for row in sector_intel.evidence_supported_sectors %}
        <tr>
          <td><strong>{{ row.code }}</strong> · {{ row.sector }}</td>
          <td>{% if report_lang == "en" %}{{ "Supported sector context" if row.status == "supported_sector_context" else "Observed context" }}{% else %}{{ "Contexto sectorial sustentado" if row.status == "supported_sector_context" else "Contexto observado" }}{% endif %}</td>
          <td>{{ row.records }} / {{ row.direct_records }} / {{ row.assured_records }}</td>
          <td>{{ row.what_it_demonstrates }}</td>
          <td>{{ row.what_it_does_not_demonstrate }}</td>
          <td>{% for link in row.evidence_links[:3] %}<a class="compact-source-link" href="{{ link.url }}" title="{{ link.url }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }} {{ loop.index }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}
    {% if public_entities.rows %}
    <h3>{{ "Public contact and profile candidates" if report_lang == "en" else "Candidatos públicos de contacto y perfil" }}</h3>
    <p class="small">{{ public_entities.method }}</p>
    <div class="evidence-table comparison-table">
      <table>
        <tr><th>{{ "Type" if report_lang == "en" else "Tipo" }}</th><th>{{ "Value" if report_lang == "en" else "Valor" }}</th><th>{{ "Scope relationship" if report_lang == "en" else "Relación con alcance" }}</th><th>{{ "What it demonstrates" if report_lang == "en" else "Qué demuestra" }}</th><th>{{ "What it does not demonstrate" if report_lang == "en" else "Qué no demuestra" }}</th><th>{{ "Evidence URLs" if report_lang == "en" else "URL de evidencia" }}</th></tr>
        {% for row in public_entities.rows %}
        <tr><td>{{ row.type }}</td><td>{{ row.value }}</td><td>{{ row.relationship_to_scope }}</td><td>{{ row.what_it_demonstrates }}</td><td>{{ row.what_it_does_not_demonstrate }}</td><td>{% for url in row.evidence_urls[:3] %}<a class="compact-source-link" href="{{ url }}" title="{{ url }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }} {{ loop.index }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}
    <div class="evidence-table comparison-table">
      <table>
        <tr><th>{{ "Role" if report_lang == "en" else "Rol" }}</th><th>{{ "Domain" if report_lang == "en" else "Dominio" }}</th><th>{{ "Results" if report_lang == "en" else "Resultados" }}</th><th>{{ "Sources" if report_lang == "en" else "Fuentes" }}</th><th>{{ "Categories" if report_lang == "en" else "Categorías" }}</th></tr>
        {% for row in domain_comparison_rows %}
        <tr><td>{{ row.role }}</td><td>{{ row.domain }}</td><td>{{ row.events }}</td><td>{{ row.sources }}</td><td>{{ row.categories }}</td></tr>
        {% endfor %}
      </table>
    </div>
    <h3>{{ "Domain-level technical reading" if report_lang == "en" else "Lectura técnica por dominio" }}</h3>
    <div class="evidence-table comparison-table">
      <table>
        <tr><th>{{ "Domain" if report_lang == "en" else "Dominio" }}</th><th>{{ "Associated records" if report_lang == "en" else "Registros asociados" }}</th><th>{{ "Supported scenarios" if report_lang == "en" else "Escenarios respaldados" }}</th><th>{{ "Direct residual risk" if report_lang == "en" else "Riesgo residual directo" }}</th><th>{{ "Top signal" if report_lang == "en" else "Señal principal" }}</th><th>{{ "Sources" if report_lang == "en" else "Fuentes" }}</th></tr>
        {% for row in domain_reading_rows %}
