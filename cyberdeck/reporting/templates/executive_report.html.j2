<!doctype html>
{% set report_lang = organization.language | default("es") %}
{% set scenario_library = scenario_library | default({"reference_template_count": 0, "defined_count": 0, "executable_count": 0, "tested_count": 0, "active_count": 0, "sources": [], "framework_counts": [], "matches": [], "status": ("No scenario context was attached to this report." if report_lang == "en" else "No se adjuntó contexto de escenarios a este informe.")}, true) %}
{% set domain_reading_rows = domain_reading_rows | default([], true) %}
{% set intelligence_modules = intelligence_modules | default([], true) %}
{% set disinformation_summary = disinformation_summary | default({"risk_statement": ("No disinformation context was attached to this report." if report_lang == "en" else "No se adjuntó contexto de desinformación a este informe."), "active_evidence": 0, "active_rows": [], "tactic_counts": [], "techniques_count": 0, "tactics_count": 0, "source": "DISARM Foundation", "source_url": none}, true) %}
{% set brand_fraud_summary = brand_fraud_summary | default({"total_mentions": 0, "positive": 0, "neutral": 0, "negative": 0, "fraud_pressure_label": "0%", "reputation_impact": 0, "domain_rows": [], "lookalikes": [], "mentions": [], "narrative": ""}, true) %}
{% set model_summary = model_summary | default({"purpose": metrics.risk_methodology.purpose, "formulas": [], "assumptions": []}, true) %}
{% set work_plan = work_plan | default({"status": "not_supported", "summary": "", "decision_gate": "", "items": []}, true) %}
{% set methodology_summary = methodology_summary | default({"steps": [], "percent_note": "", "risk_note": "", "calculation_basis": []}, true) %}
{% set vuln_intel = metrics.vulnerability_intelligence | default({"confirmed_cves": 0, "kev_matches": 0, "observed_technologies": 0, "surface_assets": 0, "patch_focus": "", "method": "", "rows": []}, true) %}
{% set geo_intel = metrics.geographic_intelligence | default({"incorporation_country": organization.country, "incorporation_country_label": organization.country, "declared_countries_of_operation": [], "declared_country_labels": [], "country_inventory": [], "evidence_supported_countries": [], "method": "", "limitations": ""}, true) %}
{% set sector_intel = metrics.sector_intelligence | default({"declared_sectors": [organization.sector], "declared_subsector": organization.subsector, "evidence_supported_sectors": [], "method": "", "limitations": ""}, true) %}
{% set layered_risk = metrics.layered_scenario_risk | default({"status": "no_data", "scenarios": []}, true) %}
{% set prospective = metrics.prospective_attack_risk | default({"status": "insufficient_evidence", "pressure_index_30d": none, "evidence_confidence": 0, "trend": {"direction": "insufficient_evidence", "change_ratio": none}, "attack_probability": {"value": none, "status": "not_calibrated"}, "scenarios": []}, true) %}
{% set relationship_risk = metrics.relationship_risk_intelligence | default({"third_party": {"status": "no_data", "rows": []}, "domain_abuse": {"status": "no_data", "rows": []}, "competitive_context": {"status": "no_data", "rows": []}}, true) %}
{% set executive_alerts = executive_alerts | default([], true) %}
{% set cti = metrics.cti | default({}, true) %}
{% set cti_overview = cti.overview | default({}, true) %}
{% set cti_states_es = {"OBSERVED": "Observado", "INFERRED": "Inferido", "RELATED": "Relacionado", "REFERENCE": "Referencia"} %}
{% set heat_labels_es = {"critical": "Crítico", "high": "Alto", "medium": "Medio", "low": "Bajo", "no_data": "Sin datos"} %}
{% set relationship_status_es = {"similar_domain_observed": "Dominio similar observado", "third_party_observed": "Tercero observado", "contextual_relationship": "Relación contextual", "no_data": "Sin datos suficientes"} %}
{% set strategic_labels_en = {"cyber_geopolitics": "Geopolitics, public policy and state threat", "cyber_economy": "Digital economy, fraud and financial pressure", "cyber_human": "Human factors, digital trust and social manipulation", "cyber_technology": "Technology dependency, vulnerabilities and attack surface", "cyber_resilience": "Physical, energy and environmental resilience and digital continuity", "cyber_legal": "Regulation, privacy, compliance and cyber liability", "cyber_rivalry": "Digital rivalry and competitive cybersecurity pressure", "cyber_new_entrants": "New digital entrants and attack-surface expansion", "cyber_suppliers": "Cyber power and dependency of suppliers and third parties", "cyber_customers": "Security power and demands of customers, partners and channels", "cyber_substitutes": "Technology substitution and cyber-risk displacement"} %}
{% set strategic_short_en = {"cyber_geopolitics": "Geopolitics and state threat", "cyber_economy": "Digital economy and fraud", "cyber_human": "Human factors and manipulation", "cyber_technology": "Technology and surface", "cyber_resilience": "Resilience and continuity", "cyber_legal": "Regulation and liability", "cyber_rivalry": "Digital rivalry", "cyber_new_entrants": "New entrants", "cyber_suppliers": "Suppliers and third parties", "cyber_customers": "Customers and partners", "cyber_substitutes": "Technology substitution"} %}
{% set pestel_labels_es = {"cyber_geopolitics": "Geopolítica, política pública y amenaza estatal", "cyber_economy": "Economía digital, fraude y presión financiera", "cyber_human": "Factor humano, confianza digital y manipulación social", "cyber_technology": "Dependencia tecnológica, vulnerabilidades y superficie de ataque", "cyber_resilience": "Resiliencia física, energética, ambiental y continuidad digital", "cyber_legal": "Regulación, privacidad, cumplimiento y responsabilidad cibernética"} %}
{% set porter_labels_es = {"cyber_rivalry": "Rivalidad digital y presión competitiva de ciberseguridad", "cyber_new_entrants": "Nuevos entrantes digitales y expansión de la superficie de ataque", "cyber_suppliers": "Poder y dependencia cibernética de proveedores y terceros", "cyber_customers": "Poder y exigencia de seguridad de clientes, aliados y canales", "cyber_substitutes": "Sustitución tecnológica y desplazamiento del riesgo cibernético"} %}
{% set snapshot_detail = false %}
<html lang="{{ report_lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="cde:run-id" content="{{ decision_snapshot.report_context.run_id }}">
  <meta name="cde:snapshot-hash" content="{{ decision_snapshot.snapshot_hash }}">
  <title>CyberDecisionEngine - {{ organization.name }}</title>
  <style>{{ css }}</style>
</head>
<body class="executive-report-v2">
<main>
  <header class="report-cover">
    <div class="eyebrow">CyberDecisionEngine · {{ "Strategic cyber intelligence" if report_lang == "en" else "Ciberinteligencia estratégica" }}</div>
    <h1>{{ decision_snapshot.report_context.report_title }}</h1>
    <p>{{ "Evidence-based reading for corporate risk and decision-making." if report_lang == "en" else "Lectura sustentada en evidencia para riesgo corporativo y toma de decisiones." }}</p>
    <div class="meta report-cover-meta">
      <div><span>{{ "Organization" if report_lang == "en" else "Organización" }}</span><strong>{{ decision_snapshot.report_context.group_name or organization.name }}</strong></div>
      <div><span>{{ "Sector" if report_lang == "en" else "Sector" }}</span><strong>{{ display_sector }}</strong></div>
      <div><span>{{ "Country" if report_lang == "en" else "País" }}</span><strong>{{ display_country }}</strong></div>
      <div><span>{{ "Analysis range" if report_lang == "en" else "Rango analizado" }}</span><strong>{{ report_scope.analysis_window }}</strong></div>
      {% if report_scope.analysis_period %}<div><span>{{ "Evidence dates" if report_lang == "en" else "Fechas de la evidencia" }}</span><strong>{{ report_scope.analysis_period.dated_in_period_records }} {{ "within period" if report_lang == "en" else "del período" }} · {{ report_scope.analysis_period.undated_records }} {{ "undated, included" if report_lang == "en" else "sin fecha, incluidas" }}</strong><p>{{ "Undated evidence is analyzed, but its membership in the period is unverified. Present-day observations do not establish historical conditions." if report_lang == "en" else "La evidencia sin fecha se analiza, pero su pertenencia al período no es verificable. Las observaciones actuales no demuestran condiciones históricas." }}</p></div>{% endif %}
      <div><span>{{ report_display.label }}</span><strong>{{ report_display.datetime }}</strong></div>
      <div>{% if report_scope.primary_domains %}<span>{{ "Analysed domains" if report_lang == "en" else "Dominios analizados" }}</span><strong>{{ report_scope.primary_domains | length }}</strong>{% else %}<span>{{ "Analysed targets" if report_lang == "en" else "Objetivos analizados" }}</span><strong>{{ decision_snapshot.analyzed_entities | length }}</strong>{% endif %}</div>
    </div>
  </header>

  <nav class="report-nav report-nav-seven" aria-label="{{ 'Report navigation' if report_lang == 'en' else 'Navegación del informe' }}">
    <a href="#decision">{{ "Decision" if report_lang == "en" else "Decisión" }}</a>
    <a href="#exposure">{{ "Exposure and risk" if report_lang == "en" else "Exposición y riesgo" }}</a>
    <a href="#threat-matrix">{{ "Threat matrix" if report_lang == "en" else "Matriz de amenazas" }}</a>
    <a href="#strategy">{{ "PESTEL-Porter" }}</a>
    <a href="#scenarios">{{ "Scenarios" if report_lang == "en" else "Escenarios" }}</a>
    <a href="#posture">{{ "Posture" if report_lang == "en" else "Postura" }}</a>
    <a href="#appendices">{{ "Appendices" if report_lang == "en" else "Anexos" }}</a>
  </nav>

  {% include "decision_snapshot.html.j2" %}

  <section id="exposure" class="report-primary-section">
    <div class="report-section-header">
      <div><span class="section-kicker">02</span><h2>{{ "Exposure and principal risks" if report_lang == "en" else "Exposición y riesgos principales" }}</h2><p>{{ "Validated findings and contextual signals are separated to avoid treating mentions as incidents." if report_lang == "en" else "Los hallazgos validados y las señales contextuales se separan para no tratar menciones como incidentes." }}</p></div>
    </div>
    <div class="kpi-grid executive-kpis">
      <div class="metric"><span>{{ terms.external_exposure_intelligence_index }}</span><strong>{{ "%.1f"|format(metrics.posture_index) }}/100</strong><small>{{ "Exposure indicator; not compliance" if report_lang == "en" else "Indicador de exposición; no mide cumplimiento" }}</small><div class="bar"><i style="width: {{ metrics.posture_index }}%"></i></div></div>
      <div class="metric"><span>{{ "Maximum residual risk" if report_lang == "en" else "Riesgo residual máximo" }}</span><strong>{% if risk_digest.max_residual is not none %}{{ "%.1f"|format(risk_digest.max_residual) }}{% else %}N/D{% endif %}</strong><small>{{ risk_digest.max_label }}</small></div>
      <div class="metric"><span>{{ "Unique records" if report_lang == "en" else "Registros únicos" }}</span><strong>{{ processing_summary.unique_records | default(report_scope.event_count) }}</strong><small>{{ processing_summary.validated_evidence | default(0) }} {{ terms.validated_evidence | lower }}</small></div>
      <div class="metric"><span>{{ "Validated findings" if report_lang == "en" else "Hallazgos validados" }}</span><strong>{{ processing_summary.validated_findings | default(0) }}</strong><small>{{ processing_summary.confirmed_incidents | default(0) }} {{ "confirmed incidents" if report_lang == "en" else "incidentes confirmados" }}</small></div>
      <div class="metric"><span>{{ "Fraud pressure" if report_lang == "en" else "Presión de fraude" }}</span><strong>{{ brand_fraud_summary.fraud_pressure_label }}</strong><small>{{ brand_fraud_summary.negative }} {{ "negative phrases" if report_lang == "en" else "frases negativas" }}</small></div>
      <div class="metric"><span>{{ terms.signal_pressure_index }}</span><strong>{{ prospective.pressure_index_30d if prospective.pressure_index_30d is not none else "N/D" }}</strong><small>{{ "This is not an attack probability; calibration is unavailable." if report_lang == "en" else "No es una probabilidad de ataque; no dispone de calibración." }}</small></div>
      <div class="metric"><span>{{ "Vulnerability focus" if report_lang == "en" else "Foco de vulnerabilidades" }}</span><strong>{{ vuln_intel.confirmed_cves }}</strong><small>{{ "applicable CVEs" if report_lang == "en" else "CVE aplicables" }} · {{ vuln_intel.kev_matches }} KEV</small></div>
    </div>

    <div class="risk-overview-layout">
      <article class="visual-panel">
        <h3>{{ "Risk heat map" if report_lang == "en" else "Mapa de calor de riesgo" }}</h3>
        {% if decision_snapshot.chart_eligibility.risk_heatmap.eligible %}
        <table class="heatmap"><tr><th>{{ "Likelihood / Impact" if report_lang == "en" else "Plausibilidad / Impacto" }}</th><th>1</th><th>2</th><th>3</th><th>4</th></tr>{% for row in heatmap %}<tr><th>{{ 5 - loop.index }}</th>{% for cell in row %}<td class="{{ cell.class }}">{{ cell.score }}<br><span class="small">{{ cell.count }}</span></td>{% endfor %}</tr>{% endfor %}</table>
        {% else %}<div class="empty-state"><strong>{{ "Chart not calculated" if report_lang == "en" else "Gráfica no calculada" }}</strong><p>{{ decision_snapshot.chart_eligibility.risk_heatmap.reason }}</p></div>{% endif %}
      </article>
      <article class="visual-panel risk-radar-panel">
        <h3>{{ "Cyber-risk heat radar" if report_lang == "en" else "Radar-calor de ciberriesgos" }}</h3>
        <p class="small">{{ metrics.risk_heat_radar.how_to_read }}</p>
        {% include 'evidence_review_outcome.html.j2' %}
        <div class="risk-radar-layout">
          <div class="risk-radar-chart">{{ radars.risk_heat | safe }}</div>
          <div class="risk-heat-reading">
            <p class="risk-reading-note"><strong>{{ "Interpretation rule" if report_lang == "en" else "Regla de lectura" }}:</strong> {{ "N/D means that the available evidence is insufficient; it is not zero risk. The coloured radius is the exact score on a 0-100 scale." if report_lang == "en" else "N/D significa que la evidencia disponible es insuficiente; no equivale a riesgo cero. El radio coloreado representa el puntaje exacto en escala de 0 a 100." }}</p>
            <div class="report-table-scroll risk-heat-table">
              <table>
                <thead><tr><th>#</th><th>{{ "Risk type" if report_lang == "en" else "Tipo de riesgo" }}</th><th>{{ "Intensity" if report_lang == "en" else "Intensidad" }}</th><th>{{ "Support" if report_lang == "en" else "Respaldo" }}</th><th>{{ "Executive reading" if report_lang == "en" else "Lectura ejecutiva" }}</th></tr></thead>
                <tbody>{% for row in metrics.risk_heat_radar.rows %}<tr><td><span class="risk-index {{ row.heat }}">{{ row.index }}</span></td><td><strong>{{ row.name }}</strong></td><td>{% if row.score is not none and row.value_status != "no_data" %}{{ "%.1f"|format(row.score * 100) }}/100<br><span class="small">{{ row.heat if report_lang == "en" else heat_labels_es.get(row.heat, row.heat) }}</span>{% else %}<strong>N/D</strong><br><span class="small">{{ "Insufficient evidence" if report_lang == "en" else "Evidencia insuficiente" }}</span>{% endif %}</td><td>{{ row.finding_count }} {{ "findings" if report_lang == "en" else "hallazgos" }}<br><span class="small">{{ row.evidence_count }} {{ "module evidence items" if report_lang == "en" else "evidencias del módulo" }}</span></td><td>{{ row.decision }}</td></tr>{% endfor %}</tbody>
              </table>
            </div>
          </div>
        </div>
      </article>
    </div>

    <section class="executive-relationship-panel" aria-labelledby="executive-relationships-title">
      <div class="relationship-panel-head"><div><span class="section-kicker">{{ "RELATIONSHIP RISK" if report_lang == "en" else "RIESGO RELACIONAL" }}</span><h3 id="executive-relationships-title">{{ "Relationships, third parties and similar domains" if report_lang == "en" else "Relaciones, terceros y dominios similares" }}</h3><p>{{ "Declared relationships and observed candidates are separated from confirmed malicious activity." if report_lang == "en" else "Las relaciones declaradas y los candidatos observados se separan de cualquier actividad maliciosa confirmada." }}</p></div></div>
      <div class="relationship-kpis">
        <article><span>{{ "Evidence-supported third parties" if report_lang == "en" else "Terceros con evidencia" }}</span><strong>{{ relationship_risk.third_party.rows | length }}</strong></article>
        <article><span>{{ "Observed similar domains" if report_lang == "en" else "Dominios similares observados" }}</span><strong>{{ relationship_risk.domain_abuse.rows | length }}</strong></article>
        <article><span>{{ "Competitive relationships" if report_lang == "en" else "Relaciones competitivas" }}</span><strong>{{ relationship_risk.competitive_context.rows | length }}</strong></article>
      </div>
      <div class="relationship-grid">
        <article><h4>{{ "Related third parties" if report_lang == "en" else "Terceras partes relacionadas" }}</h4>{% if relationship_risk.third_party.rows %}<div class="relationship-list">{% for item in relationship_risk.third_party.rows %}<div class="relationship-row"><div><strong>{{ item.name }}</strong><span>{{ item.record_count }} {{ "records" if report_lang == "en" else "registros" }} · {{ item.risk_signal_count }} {{ "supported signals" if report_lang == "en" else "señales respaldadas" }}</span></div>{% if item.urls %}<a href="{{ item.urls[0] }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }}</a>{% endif %}</div>{% endfor %}</div>{% else %}<div class="empty-state">{{ "No third party crossed the evidence threshold in this run." if report_lang == "en" else "Ninguna tercera parte cruzó el umbral de evidencia en esta corrida." }}</div>{% endif %}</article>
        <article><h4>{{ "Observed similar-domain candidates" if report_lang == "en" else "Candidatos observados de dominio similar" }}</h4>{% if relationship_risk.domain_abuse.rows %}<div class="relationship-list">{% for item in relationship_risk.domain_abuse.rows %}<div class="relationship-row"><div><strong>{{ item.candidate_domain }}</strong><span>{{ (item.similarity * 100) | round(0) }}% {{ "similarity to" if report_lang == "en" else "de similitud con" }} {{ item.target_domain }} · {{ item.status if report_lang == "en" else relationship_status_es.get(item.status, item.status) }}</span></div>{% if item.urls %}<a href="{{ item.urls[0] }}">{{ "Open evidence" if report_lang == "en" else "Abrir evidencia" }}</a>{% endif %}</div>{% endfor %}</div>{% else %}<div class="empty-state">{{ "No observed similar-domain candidate was available." if report_lang == "en" else "No se obtuvo un candidato observado de dominio similar." }}</div>{% endif %}</article>
      </div>
      <p class="small relationship-limit">{{ "Similarity does not prove phishing, fraud, cybersquatting, ownership or adversary control." if report_lang == "en" else "La similitud no demuestra phishing, fraude, ciberocupación, titularidad ni control adversario." }}</p>
    </section>

    <div class="executive-alert-grid">
      {% for alert in executive_alerts[:6] %}
      <article class="executive-alert-card"><span class="priority-badge">{{ alert.priority }}</span><h3>{{ alert.title }}</h3><p>{{ alert.validation }}</p><small>{{ alert.basis }}</small>{% if alert.urls %}<a href="{{ alert.urls[0] }}">{{ "Review evidence" if report_lang == "en" else "Revisar evidencia" }}</a>{% endif %}</article>
      {% else %}<div class="empty-state">{{ "No executive alert crossed the evidence threshold." if report_lang == "en" else "Ninguna alerta ejecutiva cruzó el umbral de evidencia." }}</div>{% endfor %}
    </div>

    <details class="report-detail-block">
      <summary>{{ "Detailed findings and brand risk" if report_lang == "en" else "Detalle de hallazgos y riesgo de marca" }}</summary>
      <div class="report-module-body">
        {% for finding in top_findings %}
        <article class="finding compact-finding"><div class="finding-head"><div><h3>{{ loop.index }}. {{ finding.title }}</h3><span class="badge {{ finding.evidence_status }}">{{ finding.evidence_status }}</span><span class="badge">{{ finding.matrix_label }}</span></div><div class="score">{{ "%.1f"|format(finding.residual_risk) }}</div></div><p>{{ finding.evidence | join(" ") }}</p><ul>{% for recommendation in finding.recommendations %}<li>{{ recommendation }}</li>{% endfor %}</ul></article>
        {% endfor %}
        <article><h3>{{ "Brand and reputation" if report_lang == "en" else "Marca y reputación" }}</h3><p>{{ brand_fraud_summary.narrative }}</p>{% for row in brand_fraud_summary.domain_rows[:6] %}<div class="brand-domain-row"><div><strong>{{ row.domain }}</strong><span>{{ row.total }} {{ "signals" if report_lang == "en" else "señales" }} · {{ row.impact }}%</span></div><div class="brand-stack"><i class="negative" style="width: {{ row.negative_pct }}%"></i><i class="neutral" style="width: {{ row.neutral_pct }}%"></i><i class="positive" style="width: {{ row.positive_pct }}%"></i></div></div>{% endfor %}</article>
      </div>
    </details>
  </section>

  <section id="threat-matrix" class="report-primary-section">
    <div class="report-section-header"><div><span class="section-kicker">03</span><h2>{{ "Threat matrix" if report_lang == "en" else "Matriz de amenazas" }}</h2><p>{{ "Actors, groups, threats, campaigns, software and TTPs are shown by analytical state. Contextual relevance does not confirm hostile activity against the organization." if report_lang == "en" else "Actores, grupos, amenazas, campañas, software y TTP se muestran por estado analítico. La relevancia contextual no confirma actividad hostil contra la organización." }}</p></div></div>
    <div class="kpi-grid cti-kpi-grid" data-cti-actor-count="{{ cti_overview.actor_count | default(0, true) }}" data-cti-campaign-count="{{ cti_overview.campaign_count | default(0, true) }}" data-cti-technique-count="{{ cti_overview.technique_count | default(0, true) }}">
      <div class="cti-kpi"><b>{{ cti_overview.actor_count | default(0, true) }}</b><span>{{ "Actors and groups" if report_lang == "en" else "Actores y grupos" }}</span><small>{{ "Complete detail below" if report_lang == "en" else "Detalle completo abajo" }}</small></div>
      <div class="cti-kpi"><b>{{ cti_overview.campaign_count | default(0, true) }}</b><span>{{ "Campaigns" if report_lang == "en" else "Campañas" }}</span><small>{{ "Evidence-supported" if report_lang == "en" else "Respaldadas por evidencia" }}</small></div>
      <div class="cti-kpi"><b>{{ cti_overview.technique_count | default(0, true) }}</b><span>{{ "Contextualised TTP" if report_lang == "en" else "TTP contextualizadas" }}</span><small>{{ cti_overview.run_technique_count | default(0, true) }} {{ "related to the run" if report_lang == "en" else "relacionadas con la corrida" }} · {{ cti_overview.reference_technique_count | default(0, true) }} {{ "reference" if report_lang == "en" else "de referencia" }}</small></div>
      <div class="cti-kpi"><b>{{ cti_overview.observed_count | default(0, true) }}</b><span>{{ "Observed entities" if report_lang == "en" else "Entidades observadas" }}</span><small>{{ "Confirmed telemetry only" if report_lang == "en" else "Sólo telemetría confirmada" }}</small></div>
    </div>

    <div class="threat-state-legend">
      <span class="observed">{{ "Observed" if report_lang == "en" else "Observado" }}</span>
      <span class="inferred">{{ "Inferred" if report_lang == "en" else "Inferido" }}</span>
      <span class="related">{{ "Related" if report_lang == "en" else "Relacionado" }}</span>
      <span class="reference">{{ "Reference" if report_lang == "en" else "Referencia" }}</span>
    </div>
    <p class="table-context-line"><strong>{{ "Complete inventory" if report_lang == "en" else "Inventario completo" }}:</strong> {{ cti.actors | length }} {{ "entities are shown in the scrollable table; no actor or group is omitted." if report_lang == "en" else "entidades se muestran en la tabla desplazable; no se omite ningún actor o grupo." }}</p>
    <div class="report-table-scroll executive-threat-table">
      <table>
        <thead><tr><th>{{ "Entity" if report_lang == "en" else "Entidad" }}</th><th>{{ "State" if report_lang == "en" else "Estado" }}</th><th>{{ "Contextual relevance" if report_lang == "en" else "Relevancia contextual" }}</th><th>{{ "Campaigns" if report_lang == "en" else "Campañas" }}</th><th>ATT&amp;CK TTP</th><th>D3FEND</th><th>{{ "Evidence" if report_lang == "en" else "Evidencia" }}</th></tr></thead>
        <tbody>
          {% for actor in cti.actors %}
          <tr class="threat-entity-row"><td><strong>{{ actor.name }}</strong><br><span class="small">{{ actor.explanation }}</span></td><td><span class="cti-state {{ actor.state | lower }}">{{ actor.state if report_lang == "en" else cti_states_es.get(actor.state, actor.state) }}</span></td><td>{{ actor.relevance_score }}/100</td><td>{{ actor.campaigns | join(" · ") if actor.campaigns else "N/D" }}</td><td>{% if actor.techniques %}<details class="table-cell-details"><summary>{{ actor.techniques | length }} TTP</summary><div>{% for technique in actor.techniques %}<span>{{ technique }}</span>{% endfor %}</div></details>{% else %}N/D{% endif %}</td><td>{% if actor.d3fend %}<details class="table-cell-details"><summary>{{ actor.d3fend | length }} D3FEND</summary><div>{% for control in actor.d3fend %}<span>{{ control.id }}{% if control.name %} · {{ control.name }}{% endif %}</span>{% endfor %}</div></details>{% else %}N/D{% endif %}</td><td>{{ actor.evidence_count }} · {{ actor.source_count }} {{ "sources" if report_lang == "en" else "fuentes" }}{% if actor.evidence_urls %}<br><a href="{{ actor.evidence_urls[0] }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }}</a>{% endif %}</td></tr>
          {% else %}<tr><td colspan="7">{{ "No traceable actor attribution was identified." if report_lang == "en" else "No se identificó atribución trazable de actor." }}</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>

    <div class="grid two threat-support-grid">
      <article>
        <h3>MITRE ATT&amp;CK / D3FEND</h3>
        <div class="framework-chip-row">{% for item in framework_summary.catalog if "MITRE" in item.name or "ATT&CK" in item.name or "D3FEND" in item.name or "ATLAS" in item.name or "F3" in item.name or "AADAPT" in item.name or "EMB3D" in item.name or "INFORM" in item.name or "DISARM" in item.name %}<span class="{{ item.status }}">{{ item.name }}{% if item.version %} {{ item.version }}{% endif %} · {{ item.status_label }}</span>{% endfor %}</div>
      </article>
      <article>
        <h3>MITRE Fight Fraud Framework (F3)</h3>
        <p>{{ f3_summary.interpretation }}</p>
        <div class="framework-chip-row">{% for item in f3_summary.techniques[:8] %}<span>{{ item.id }} · {{ item.name }} · {{ item.record_count }}</span>{% else %}<span class="muted">N/D</span>{% endfor %}</div>
      </article>
    </div>
    <details class="report-detail-block threat-detail-block"><summary>{{ "Technique, campaign and narrative detail" if report_lang == "en" else "Detalle de técnicas, campañas y narrativas" }} · {{ cti.techniques | length }} TTP</summary><div class="report-module-body threat-detail-groups">
      <details class="report-subdetail"><summary><strong>{{ "Techniques and countermeasures" if report_lang == "en" else "Técnicas y contramedidas" }}</strong><span>{{ cti.techniques | length }} TTP</span></summary><div class="report-subdetail-body"><div class="report-table-scroll"><table><thead><tr><th>TTP</th><th>{{ "Family and tactics" if report_lang == "en" else "Familia y tácticas" }}</th><th>{{ "Related entities" if report_lang == "en" else "Entidades relacionadas" }}</th><th>D3FEND</th><th>{{ "State" if report_lang == "en" else "Estado" }}</th></tr></thead><tbody>{% for technique in cti.techniques %}<tr class="cti-technique-row"><td><strong>{{ technique.technique_id }}</strong><br>{{ technique.name }}</td><td>{{ technique.family }}<br><span class="small">{{ technique.tactics | join(" · ") if technique.tactics else "N/D" }}</span></td><td>{{ technique.actors | join(" · ") if technique.actors else "N/D" }}</td><td>{% for control in technique.d3fend %}{{ control.id }}{% if not loop.last %} · {% endif %}{% else %}N/D{% endfor %}</td><td><span class="cti-state {{ technique.state | lower }}">{{ technique.state if report_lang == "en" else cti_states_es.get(technique.state, technique.state) }}</span></td></tr>{% else %}<tr><td colspan="5">{{ "No contextualised TTP was available." if report_lang == "en" else "No se obtuvo una TTP contextualizada." }}</td></tr>{% endfor %}</tbody></table></div></div></details>
      <details class="report-subdetail"><summary><strong>{{ "Campaigns and related entities" if report_lang == "en" else "Campañas y entidades relacionadas" }}</strong><span>{{ cti.campaigns | length }}</span></summary><div class="report-subdetail-body">{% if cti.campaigns %}<div class="report-table-scroll"><table><thead><tr><th>{{ "Campaign" if report_lang == "en" else "Campaña" }}</th><th>{{ "Entities" if report_lang == "en" else "Entidades" }}</th><th>TTP</th><th>{{ "State" if report_lang == "en" else "Estado" }}</th></tr></thead><tbody>{% for campaign in cti.campaigns %}<tr class="cti-campaign-row"><td><strong>{{ campaign.name }}</strong></td><td>{{ campaign.actors | join(" · ") if campaign.actors else "N/D" }}</td><td>{{ campaign.techniques | join(" · ") if campaign.techniques else "N/D" }}</td><td>{{ campaign.state if report_lang == "en" else cti_states_es.get(campaign.state, campaign.state) }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state">{{ "No campaign crossed the evidence threshold for this run." if report_lang == "en" else "Ninguna campaña cruzó el umbral de evidencia para esta corrida." }}</div>{% endif %}</div></details>
      <details class="report-subdetail"><summary><strong>{{ "Narratives and disinformation" if report_lang == "en" else "Narrativas y desinformación" }}</strong><span>{{ disinformation_summary.all_rows | default([], true) | length }} {{ "signals" if report_lang == "en" else "señales" }}</span></summary><div class="report-subdetail-body"><p>{{ disinformation_summary.risk_statement }}</p><div class="framework-chip-row">{% for item in disinformation_summary.tactic_counts %}<span>{{ item.name }} · {{ item.value }}</span>{% endfor %}</div>{% if disinformation_summary.all_rows %}<div class="report-table-scroll"><table><thead><tr><th>{{ "Source" if report_lang == "en" else "Fuente" }}</th><th>{{ "Classification" if report_lang == "en" else "Clasificación" }}</th><th>{{ "Signal" if report_lang == "en" else "Señal" }}</th><th>URL</th></tr></thead><tbody>{% for row in disinformation_summary.all_rows %}<tr><td>{{ row.source }}</td><td>{{ row.category }}</td><td>{{ row.title }}</td><td>{% if row.evidence_url %}<a href="{{ row.evidence_url }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }}</a>{% else %}N/D{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state">{{ "No related narrative signal was available in the current coverage." if report_lang == "en" else "No se obtuvo una señal narrativa relacionada en la cobertura actual." }}</div>{% endif %}</div></details>
    </div></details>
  </section>

  <section id="strategy" class="report-primary-section">
    <div class="report-section-header"><div><span class="section-kicker">04</span><h2>{{ "Integrated PESTEL-Porter strategic analysis" if report_lang == "en" else "Análisis estratégico PESTEL-Porter y matriz integrada" }}</h2><p>{{ "Macro-environmental and competitive pressures are read together. SignalScore is contextual intensity, not attack probability, compliance or maturity." if report_lang == "en" else "Las presiones macroambientales y competitivas se leen en conjunto. SignalScore es intensidad contextual, no probabilidad de ataque, cumplimiento ni madurez." }}</p></div></div>
    <div class="strategy-score-grid">
      <article><span>Cyber-PESTEL</span><strong>{% if metrics.pestel.signalScore is not none %}{{ "%.1f"|format(metrics.pestel.signalScore) }}/100{% else %}N/D{% endif %}</strong><small>{{ "Confidence" if report_lang == "en" else "Confianza" }} {{ "%.1f"|format(metrics.pestel.overall_confidence) }}/100 · {{ "coverage" if report_lang == "en" else "cobertura" }} {{ format_strategic_percent((metrics.pestel.evidence_coverage_ratio | default(0, true)) * 100) }}</small></article>
      <article><span>Cyber-Porter</span><strong>{% if metrics.porter.signalScore is not none %}{{ "%.1f"|format(metrics.porter.signalScore) }}/100{% else %}N/D{% endif %}</strong><small>{{ "Confidence" if report_lang == "en" else "Confianza" }} {{ "%.1f"|format(metrics.porter.overall_confidence) }}/100 · {{ "coverage" if report_lang == "en" else "cobertura" }} {{ format_strategic_percent((metrics.porter.evidence_coverage_ratio | default(0, true)) * 100) }}</small></article>
    </div>
    <div class="grid two strategic-radars"><article class="visual-panel"><h3>Cyber-PESTEL · SignalScore</h3>{{ radars.pestel | safe }}</article><article class="visual-panel"><h3>Cyber-Porter · SignalScore</h3>{{ radars.porter | safe }}</article></div>
    <h3>{{ "Integrated strategic matrix" if report_lang == "en" else "Matriz estratégica integrada" }}</h3>
    <div class="strategic-heatmap">
      {% for item in metrics.pestel.dimensions + metrics.porter.dimensions %}
      {% set value = item.signalScore %}
      <div class="strategic-heat-cell {% if value is none %}no-data{% elif value >= 75 %}critical{% elif value >= 50 %}high{% elif value >= 25 %}medium{% else %}low{% endif %}">
        <span>{{ "Cyber-PESTEL" if loop.index <= (metrics.pestel.dimensions | length) else "Cyber-Porter" }}</span>
        <strong>{{ strategic_short_en.get(item.key, item.shortName | default(item.name, true)) if report_lang == "en" else item.shortName | default(item.name, true) }}</strong>
        <b>{% if value is not none %}{{ "%.0f"|format(value) }}{% else %}N/D{% endif %}</b><i><u style="width: {{ value | default(0, true) }}%"></u></i>
        <small>{{ "Confidence" if report_lang == "en" else "Confianza" }} {{ "%.0f"|format(item.confidence) }}% · {{ "Coverage" if report_lang == "en" else "Cobertura" }} {{ format_strategic_percent(item.evidence_coverage_percent | default(0, true)) }}</small>
      </div>
      {% endfor %}
    </div>
    <details class="report-detail-block"><summary>{{ "Drivers, reducers and traceable sources" if report_lang == "en" else "Impulsores, reductores y fuentes trazables" }}</summary><div class="report-scroll report-module-body">{% for item in metrics.pestel.dimensions + metrics.porter.dimensions %}<article class="strategy-detail-card"><h3>{{ strategic_labels_en.get(item.key, item.name) if report_lang == "en" else pestel_labels_es.get(item.key, porter_labels_es.get(item.key, item.name)) }}</h3><p>{{ item.what_changed }}</p><small>{{ item.cluster_count }} {{ "clusters" if report_lang == "en" else "clústeres" }} · {{ item.independent_source_count }} {{ "independent sources" if report_lang == "en" else "fuentes independientes" }}</small>{% for event in item.drivers + item.reducers %}<div class="strategic-event"><strong>{{ event.what_happened }}</strong><span>{{ event.relationship }} · {{ event.direction }} · {{ event.magnitude }}</span>{% for url in event.evidence_urls %}<a href="{{ url }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }}</a>{% endfor %}</div>{% endfor %}<p class="small"><b>{{ "What it does not mean" if report_lang == "en" else "Qué no significa" }}:</b> {{ item.what_it_does_not_mean }}</p></article>{% endfor %}</div></details>
  </section>

  <section id="scenarios" class="report-primary-section">
    <div class="report-section-header"><div><span class="section-kicker">05</span><h2>{{ "Scenarios and recommended decisions" if report_lang == "en" else "Escenarios y decisiones recomendadas" }}</h2><p>{{ "Only scenarios with current evidence support are published as decision possibilities." if report_lang == "en" else "Solo se publican como posibilidades de decisión los escenarios que cuentan con respaldo de evidencia actual." }}</p></div></div>
    <div class="scenario-decision-report executive-scenarios">
      {% for match in scenario_library.matches[:8] %}
      <article class="scenario-report-card"><div class="scenario-head"><span class="badge">{{ match.id }}</span><strong>{{ match.confidence }}%</strong></div><h3>{{ match.title }}</h3><div class="framework-chip-row"><span>{{ match.frameworks.attack }}</span><span>{{ match.frameworks.d3fend }}</span><span>{{ match.frameworks.atlas }}</span><span>{{ match.frameworks.disarm }}</span></div><p><strong>{{ "Decision" if report_lang == "en" else "Decisión" }}:</strong> {{ match.decision }}</p><p><strong>{{ "Evidence" if report_lang == "en" else "Evidencia" }}:</strong> {{ match.evidence_label }} · {{ match.domains_label }}</p></article>
      {% else %}<div class="empty-state">{{ "No evidence-supported scenario crossed the publication threshold." if report_lang == "en" else "Ningún escenario respaldado por evidencia cruzó el umbral de publicación." }}</div>{% endfor %}
    </div>
    {% if work_plan["items"] %}
    <details class="report-detail-block"><summary>{{ "Mitigation and review plan" if report_lang == "en" else "Plan de mitigación y revisión" }} · {{ work_plan["items"] | length }}</summary><div class="work-plan-grid report-module-body">{% for item in work_plan["items"] %}<article class="work-plan-card {{ item.tone }}"><div class="work-plan-head"><span class="badge">{{ item.id }}</span><strong>{{ item.priority }}</strong></div><h3>{{ item.title }}</h3><p>{{ item.objective }}</p><p><strong>{{ "Owner" if report_lang == "en" else "Responsable" }}:</strong> {{ item.owners | join(" · ") }} · {{ item.timeframe }}</p><p>{{ item.validation }}</p></article>{% endfor %}</div></details>
    {% else %}<div class="empty-state decision-gate"><strong>{{ "No supported action plan" if report_lang == "en" else "Sin plan de acción sustentado" }}</strong><p>{{ work_plan.summary }}</p><small>{{ work_plan.decision_gate }}</small></div>{% endif %}
  </section>

  <section id="posture" class="report-primary-section">
    <div class="report-section-header"><div><span class="section-kicker">06</span><h2>{{ "Posture, controls and frameworks" if report_lang == "en" else "Postura, controles y marcos de referencia" }}</h2><p>{{ "Reference mappings indicate applicability; they do not demonstrate compliance, maturity or control effectiveness." if report_lang == "en" else "Los mapeos de referencia indican aplicabilidad; no demuestran cumplimiento, madurez ni eficacia de controles." }}</p></div></div>
    <div class="framework-chip-row framework-catalog-summary">{% for item in framework_summary.catalog %}<span class="{{ item.status }}">{{ item.name }}{% if item.version %} {{ item.version }}{% endif %} · {{ item.status_label }}</span>{% endfor %}</div>
    <div class="framework-axis-list">{% for item in framework_summary.affected_axes %}<div class="framework-axis-row"><b>{{ item.axis }}</b><span>{{ item.frameworks | join(" · ") }}</span><small>{{ item.record_count }} {{ "related records" if report_lang == "en" else "registros relacionados" }} · {{ item.validated_count }} {{ "validated" if report_lang == "en" else "validados" }}</small></div>{% else %}<div class="empty-state">{{ "No evidence-supported framework crosswalk was available." if report_lang == "en" else "No se obtuvo un cruce de marcos respaldado por evidencia." }}</div>{% endfor %}</div>
    <div class="recommendation-grid">{% for area_key, area in recommendation_catalog.items() %}{% if area["items"] %}<article class="recommendation-area"><h3>{{ area.label }}</h3>{% for rec in area["items"] %}<div class="recommendation-item"><div><strong>{{ rec.title }}</strong><span class="priority-badge {{ rec.tone }}">{{ rec.priority }}</span></div><p>{{ rec.action }}</p><small>{{ rec.owner }} · {{ rec.basis }}</small></div>{% endfor %}</article>{% endif %}{% endfor %}</div>
  </section>

  <section id="appendices" class="report-primary-section">
    <div class="report-section-header"><div><span class="section-kicker">07</span><h2>{{ "Limitations and appendices" if report_lang == "en" else "Limitaciones y anexos" }}</h2><p>{{ "Supporting detail remains available without overloading the executive reading." if report_lang == "en" else "El detalle de respaldo permanece disponible sin sobrecargar la lectura ejecutiva." }}</p></div></div>
    <div class="appendix-grid">
      <details class="report-detail-block"><summary>{{ "Scope and comparison basis" if report_lang == "en" else "Alcance y base de comparación" }}</summary><div class="report-module-body"><h3>{{ "Analysed domains" if report_lang == "en" else "Dominios analizados" }}</h3><div class="chip-list">{% for domain in report_scope.primary_domains %}<span class="chip">{{ domain }}</span>{% endfor %}</div><h3>{{ "Benchmark domains" if report_lang == "en" else "Dominios de comparación" }}</h3><div class="chip-list">{% for domain in report_scope.comparison_domains %}<span class="chip alt">{{ domain }}</span>{% else %}<span class="chip muted">N/D</span>{% endfor %}</div><p>{{ report_scope.comparison_basis }}</p><p>{{ report_scope.data_basis }}</p><p><strong>{{ "Declared sector scope" if report_lang == "en" else "Alcance sectorial declarado" }}:</strong> {{ sector_intel.declared_sectors | join(" · ") }}</p><p><strong>{{ "Declared geography" if report_lang == "en" else "Geografía declarada" }}:</strong> {{ geo_intel.declared_country_labels | join(" · ") if geo_intel.declared_country_labels else display_country }}</p></div></details>
      <details class="report-detail-block"><summary>{{ "Method and interpretation" if report_lang == "en" else "Método e interpretación" }}</summary><div class="report-module-body"><p>{{ methodology_summary.percent_note }}</p><div class="methodology-steps">{% for step in methodology_summary.steps %}<article><span>{{ "%02d"|format(loop.index) }}</span><strong>{{ step.name }}</strong><p>{{ step.detail }}</p></article>{% endfor %}</div><p>{{ methodology_summary.risk_note }}</p></div></details>
      <details class="report-detail-block"><summary>OSINT, SOCMINT, Dark Web · {{ processing_summary.unique_records | default(report_scope.event_count) }}</summary><div class="source-summary-grid report-module-body"><article><h3>OSINT</h3><strong>{{ metrics.source_coverage.osint.records }}</strong><p>{{ metrics.source_coverage.osint.purpose }}</p></article><article><h3>SOCMINT</h3><strong>{{ metrics.source_coverage.socmint.records }}</strong><p>{{ metrics.source_coverage.socmint.purpose }}</p></article><article><h3>Dark Web</h3><strong>{{ metrics.source_coverage.darkweb.records }}</strong><p>{{ metrics.source_coverage.darkweb.purpose }}</p></article></div></details>
      <details class="report-detail-block"><summary>{{ "Evidence claims" if report_lang == "en" else "Afirmaciones y evidencia" }} · {{ claim_evidence_rows | length }}</summary><div class="claim-grid executive-claims report-module-body">{% for row in claim_evidence_rows[:8] %}<article class="claim-card"><div class="claim-card-head"><span class="badge">{{ "Claim" if report_lang == "en" else "Afirmación" }} {{ loop.index }}</span><span class="badge {{ row.status }}">{{ row.status }}</span></div><h3>{{ row.what_found }}</h3><p><strong>{{ "What it demonstrates" if report_lang == "en" else "Qué demuestra" }}:</strong> {{ row.what_demonstrates }}</p><p><strong>{{ "What it does not demonstrate" if report_lang == "en" else "Qué no demuestra" }}:</strong> {{ row.what_not_demonstrates }}</p><a href="{{ technical_report_name }}#claim-{{ loop.index }}">{{ "View evidence" if report_lang == "en" else "Ver evidencia" }}</a></article>{% endfor %}</div></details>
    </div>
    <p class="report-limit-note">{{ "Conclusions are limited to evidence collected and validated within the declared scope and period. Missing data is not interpreted as zero or absence of risk." if report_lang == "en" else "Las conclusiones se limitan a la evidencia recolectada y validada dentro del alcance y periodo declarados. La falta de datos no se interpreta como cero ni como ausencia de riesgo." }}</p>
    <a class="technical-report-link" href="{{ technical_report_name }}">{{ "Open technical report" if report_lang == "en" else "Abrir informe técnico" }}</a>
  </section>

  <footer>{{ "CyberDecisionEngine · Defensive and authorized use." if report_lang == "en" else "CyberDecisionEngine · Uso defensivo y autorizado." }}</footer>
</main>
</body>
</html>
