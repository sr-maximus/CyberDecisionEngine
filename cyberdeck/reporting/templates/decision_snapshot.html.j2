{% set ds = decision_snapshot %}
{% set ds_metrics = ds.metrics %}
{% set technical_detail = snapshot_detail | default(false) %}
{% set collapsible_snapshot = snapshot_collapsible | default(false) %}
{% set status_labels = {
  "valid_value": ("Valid value" if report_lang == "en" else "Valor válido"),
  "observed_zero": ("Observed zero" if report_lang == "en" else "Cero observado"),
  "no_data": ("No data" if report_lang == "en" else "Sin datos"),
  "insufficient_evidence": ("Insufficient evidence" if report_lang == "en" else "Evidencia insuficiente"),
  "partial_data": ("Partial data" if report_lang == "en" else "Datos parciales")
} %}
{% if collapsible_snapshot %}
<details id="decision" class="report-module decision-report-module">
  <summary><span>01</span><h2>{{ "Decision in one page" if report_lang == "en" else "Decisión en una página" }}</h2><small>{{ ds.decisions | length }} {{ "decision priorities" if report_lang == "en" else "prioridades de decisión" }}</small></summary>
  <div class="report-module-body">
  <p class="decision-module-intro">{{ "Evidence status, material risks and actions requiring ownership." if report_lang == "en" else "Estado de la evidencia, riesgos materiales y acciones que requieren responsable." }}</p>
{% else %}
<section id="decision" class="decision-one-page">
  <div class="report-section-header">
    <div>
      <span class="section-kicker">{{ "EXECUTIVE DECISION" if report_lang == "en" else "DECISIÓN EJECUTIVA" }}</span>
      <h2>{{ "Decision in one page" if report_lang == "en" else "Decisión en una página" }}</h2>
      <p>{{ "Evidence status, material risks and actions requiring ownership." if report_lang == "en" else "Estado de la evidencia, riesgos materiales y acciones que requieren responsable." }}</p>
    </div>
    <span class="status-pill {{ 'ok' if ds.reference_integrity.status == 'pass' else 'warning' }}">{{ "Traceable evidence" if report_lang == "en" else "Evidencia trazable" }}</span>
  </div>
{% endif %}

  <div class="snapshot-kpis decision-kpis">
    <article><span>{{ "Confirmed incidents" if report_lang == "en" else "Incidentes confirmados" }}</span><strong>{{ ds_metrics.confirmed_incidents.value | int }}</strong><small>{{ status_labels.get(ds_metrics.confirmed_incidents.value_status, ds_metrics.confirmed_incidents.value_status) }}</small></article>
    <article><span>{{ "Validated findings" if report_lang == "en" else "Hallazgos validados" }}</span><strong>{{ ds_metrics.validated_findings.value | int }}</strong><small>{{ (ds_metrics.validated_findings.confidence * 100) | round | int }}% {{ "evidence confidence" if report_lang == "en" else "confianza de evidencia" }}</small></article>
    <article><span>{{ "Supported scenarios" if report_lang == "en" else "Escenarios respaldados" }}</span><strong>{{ ds_metrics.supported_scenarios.value | int }}</strong><small>{{ status_labels.get(ds_metrics.supported_scenarios.value_status, ds_metrics.supported_scenarios.value_status) }}</small></article>
    <article><span>{{ "Maximum residual risk" if report_lang == "en" else "Riesgo residual máximo" }}</span><strong>{% if ds_metrics.max_residual_risk.value is not none %}{{ "%.2f"|format(ds_metrics.max_residual_risk.value) }}{% else %}N/D{% endif %}</strong><small>{{ status_labels.get(ds_metrics.max_residual_risk.value_status, ds_metrics.max_residual_risk.value_status) }}</small></article>
    <article><span>{{ "Pending decisions" if report_lang == "en" else "Decisiones pendientes" }}</span><strong>{{ ds_metrics.pending_decisions.value | int }}</strong><small>{{ ds_metrics.pending_decisions.period }}</small></article>
  </div>

  <div class="decision-overview-grid">
    <article class="snapshot-panel decision-list-panel">
      <div class="snapshot-panel-head"><h3>{{ "Decision priorities" if report_lang == "en" else "Prioridades de decisión" }}</h3><span>{{ ds.decisions | length }}</span></div>
      <div class="decision-list">
        {% for decision in ds.decisions %}
        <div class="decision-list-item {{ decision.status }}">
          <div>
            <span class="decision-status {{ decision.status }}">{{ "Act now" if decision.status == "act_now" and report_lang == "en" else "Actuar ahora" if decision.status == "act_now" else "Validate first" if report_lang == "en" else "Validar primero" }}</span>
            <strong>{{ decision.title }}</strong>
            <p>{{ decision.rationale }}</p>
          </div>
          <dl>
            <div><dt>{{ "Owner" if report_lang == "en" else "Responsable" }}</dt><dd>{{ decision.owner_role }}</dd></div>
            <div><dt>{{ "Window" if report_lang == "en" else "Ventana" }}</dt><dd>{{ decision.due_window }}</dd></div>
            <div><dt>{{ "Success" if report_lang == "en" else "Éxito" }}</dt><dd>{{ decision.success_measure }}</dd></div>
          </dl>
        </div>
        {% else %}
        <div class="snapshot-empty">{{ "There is no evidence-supported action in the current analysis." if report_lang == "en" else "No existe una acción respaldada por evidencia en el análisis actual." }}</div>
        {% endfor %}
      </div>
    </article>

    <article class="snapshot-panel">
      <div class="snapshot-panel-head"><h3>{{ "Scenario progression" if report_lang == "en" else "Progresión de escenarios" }}</h3><span>{{ ds.scenario_funnel.supported }} {{ "supported" if report_lang == "en" else "respaldados" }}</span></div>
      <div class="scenario-funnel">
        <div><span>{{ "Candidates" if report_lang == "en" else "Candidatos" }}</span><strong>{{ ds.scenario_funnel.candidate }}</strong></div>
        <div><span>{{ "Supported" if report_lang == "en" else "Respaldados" }}</span><strong>{{ ds.scenario_funnel.supported }}</strong></div>
        <div><span>{{ "Validated" if report_lang == "en" else "Validados" }}</span><strong>{{ ds.scenario_funnel.validated }}</strong></div>
        <div><span>{{ "Confirmed" if report_lang == "en" else "Confirmados" }}</span><strong>{{ ds.scenario_funnel.confirmed }}</strong></div>
      </div>
      {% for scenario in ds.supported_scenarios[:4] %}
      <div class="snapshot-scenario"><div><span>{{ "Scenario" if report_lang == "en" else "Escenario" }} {{ loop.index }}</span><strong>{{ scenario.title }}</strong></div><p>{{ scenario.decision_possibility }}</p><small>{{ scenario.domain }} · {{ scenario.status }} · {{ (scenario.confidence * 100) | round | int }}%</small></div>
      {% else %}<div class="snapshot-empty">{{ "No scenario crossed the evidence support threshold." if report_lang == "en" else "Ningún escenario cruzó el umbral de respaldo de evidencia." }}</div>{% endfor %}
    </article>
  </div>

  {% if technical_detail %}
  <details class="report-detail-block">
    <summary>{{ "Analysed scope" if report_lang == "en" else "Alcance analizado" }} · {{ (ds.domains | length) if ds.domains else (ds.analyzed_entities | length) }}</summary>
    <div class="report-scroll snapshot-domain-list">
      {% for row in ds.domains %}
      <div class="snapshot-domain-row"><div><strong>{{ row.domain }}</strong><small>{{ row.top_signal or ("No direct signal" if report_lang == "en" else "Sin señal directa") }}</small></div><div class="domain-facts"><span><b>{{ row.record_count }}</b> {{ "records" if report_lang == "en" else "registros" }}</span><span><b>{{ row.validated_findings_count }}</b> {{ "findings" if report_lang == "en" else "hallazgos" }}</span><span><b>{% if row.max_residual_risk is not none %}{{ "%.2f"|format(row.max_residual_risk) }}{% else %}N/D{% endif %}</b> {{ "risk" if report_lang == "en" else "riesgo" }}</span></div></div>
      {% endfor %}
    </div>
  </details>
  <details class="report-detail-block">
    <summary>{{ "Complete evidence references" if report_lang == "en" else "Referencias completas de evidencia" }} · {{ ds.evidence_references | length }}</summary>
    <div class="report-scroll report-table-scroll snapshot-reference-table"><table><thead><tr><th>#</th><th>{{ "Type" if report_lang == "en" else "Tipo" }}</th><th>{{ "Domain" if report_lang == "en" else "Dominio" }}</th><th>{{ "Title" if report_lang == "en" else "Título" }}</th><th>{{ "Validation" if report_lang == "en" else "Validación" }}</th><th>URL</th></tr></thead><tbody>{% for ref in ds.evidence_references %}<tr><td>{{ loop.index }}</td><td>{{ ref.record_type }}</td><td>{{ ref.domain or "N/D" }}</td><td>{{ ref.title }}</td><td>{{ ref.validation_status }} · {{ (ref.confidence * 100) | round | int }}%</td><td>{% if ref.url %}<a class="compact-source-link" href="{{ ref.url }}">{{ "Open source" if report_lang == "en" else "Abrir fuente" }}</a>{% else %}<span class="small">N/D</span>{% endif %}</td></tr>{% endfor %}</tbody></table></div>
  </details>
  {% else %}
  <p class="snapshot-reference-note"><strong>{{ "Analysed scope" if report_lang == "en" else "Alcance analizado" }}:</strong> {{ (ds.domains | length) if ds.domains else (ds.analyzed_entities | length) }} · <strong>{{ "Traceable references" if report_lang == "en" else "Referencias trazables" }}:</strong> {{ ds.evidence_references | length }}</p>
  {% endif %}

  <details class="snapshot-limitations"><summary>{{ "Limits and unavailable calculations" if report_lang == "en" else "Limitaciones y cálculos no disponibles" }}</summary><ul>{% for item in ds.limitations %}<li>{{ item }}</li>{% endfor %}</ul></details>
{% if collapsible_snapshot %}
  </div>
</details>
{% else %}
</section>
{% endif %}
