# OpenClaw is optional and disabled by default.
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AUTOMATION_MODE=analysis_only

# The gateway must enforce these policies outside the application too:
# - proposal-only responses;
# - read-only run context;
# - allowlisted tools and collectors;
# - no shell, browser automation or scheduling without admin approval;
# - organization and run isolation;
# - bounded time, concurrency and token budgets.
